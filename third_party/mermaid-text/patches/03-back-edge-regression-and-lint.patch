+//! Regression for perpendicular back-edge ports with non-rectangle nodes.
+use mermaid_text::{RenderOptions, render_with_options};
+
+#[test]
+fn non_rectangle_back_edges_keep_their_labels() {
+    for direction in ["TD", "LR"] {
+        for review in ["r{Review}", "r([Review])"] {
+            let source = format!(
+                "flowchart {direction}\n p[Plan] --> b[Build]\n b --> {review}\n r -->|findings| b\n r --> q[QA]\n q -->|fail| b\n q --> m[Merge]\n"
+            );
+            for width in [None, Some(40), Some(60), Some(80), Some(120)] {
+                let drawing = render_with_options(
+                    &source,
+                    &RenderOptions {
+                        max_width: width,
+                        ..Default::default()
+                    },
+                )
+                .expect("valid flowchart");
+                for label in ["findings", "fail"] {
+                    assert!(
+                        drawing.contains(label),
+                        "{direction} {review} {width:?} lost {label}:\n{drawing}"
+                    );
+                }
+            }
+        }
+    }
+}
