@@ -0,0 +1,179 @@
+//! Sequence diagrams honour `max_width`: gaps narrow and labels wrap so the
+//! render fits the budget, while unbudgeted (or already fitting) renders stay
+//! byte-identical to the natural layout.
+
+use mermaid_text::{Error, RenderOptions, render, render_with_options, render_with_width};
+use unicode_width::UnicodeWidthStr;
+
+fn widest(s: &str) -> usize {
+    s.lines().map(UnicodeWidthStr::width).max().unwrap_or(0)
+}
+
+const WIDE: &str = "sequenceDiagram
+    participant H as Host CLI
+    participant C as Space controller
+    participant O as OpenShell supervisor
+    participant A as Agent session
+    H->>C: box start the worker with a fresh session and the team account
+    C->>O: create sandbox with the computed policy and mounts
+    O-->>C: sandbox ready and SSH endpoint published
+    C->>A: launch the agent through the supervisor endpoint
+    A-->>H: attach stream with resize and signals
+    Note over C,O: policy goldens must match byte for byte before launch
+";
+
+const RICH: &str = "sequenceDiagram
+    autonumber
+    participant U as Operator
+    participant T as TUI client
+    participant S as Session holder
+    U->>T: open the follow view for the selected box
+    activate T
+    T->>S: attach with snapshot restore and resize events
+    activate S
+    S->>S: replay canonical VT state from the exact build
+    S-->>T: snapshot plus live output stream
+    deactivate S
+    alt the session is gone
+        T-->>U: show the reconnect banner with the last known status
+    else still running
+        T-->>U: render frames
+    end
+    Note right of S: holder answers terminal queries exactly once
+    deactivate T
+";
+
+/// Words of `src`'s labels that must survive wrapping intact at `budget`.
+fn assert_words_kept(out: &str, words: &[&str]) {
+    for word in words {
+        assert!(out.contains(word), "missing {word:?} in:\n{out}");
+    }
+}
+
+#[test]
+fn no_budget_and_fitting_budget_keep_the_natural_render() {
+    for src in [WIDE, RICH] {
+        let natural = render(src).unwrap();
+        assert_eq!(render_with_width(src, None).unwrap(), natural);
+        let w = widest(&natural);
+        assert_eq!(render_with_width(src, Some(w)).unwrap(), natural);
+        assert_eq!(render_with_width(src, Some(w + 40)).unwrap(), natural);
+    }
+}
+
+#[test]
+fn wide_sequence_fits_common_budgets() {
+    for budget in [40, 60, 80, 120] {
+        let out = render_with_width(WIDE, Some(budget)).unwrap();
+        assert!(
+            widest(&out) <= budget,
+            "budget {budget}: widest {}\n{out}",
+            widest(&out)
+        );
+        assert_words_kept(
+            &out,
+            &["box", "start", "sandbox", "launch", "attach", "policy"],
+        );
+    }
+    // At a comfortable budget nothing has to be hard-split.
+    let out = render_with_width(WIDE, Some(80)).unwrap();
+    assert_words_kept(
+        &out,
+        &[
+            "Space controller",
+            "OpenShell supervisor",
+            "computed",
+            "published",
+            "supervisor",
+            "goldens",
+        ],
+    );
+}
+
+#[test]
+fn activations_self_messages_notes_and_blocks_fit() {
+    for budget in [40, 60, 80] {
+        let out = render_with_width(RICH, Some(budget)).unwrap();
+        assert!(
+            widest(&out) <= budget,
+            "budget {budget}: widest {}\n{out}",
+            widest(&out)
+        );
+        assert_words_kept(
+            &out,
+            &["[1]", "[3]", "[6]", "replay", "render", "frames", "once"],
+        );
+    }
+}
+
+#[test]
+fn wrapped_labels_stack_above_their_arrow() {
+    let src = "sequenceDiagram\n    participant A\n    participant B\n    A->>B: one two three four five six seven eight\n";
+    let out = render_with_width(src, Some(24)).unwrap();
+    assert!(widest(&out) <= 24, "{out}");
+    let rows: Vec<&str> = out.lines().collect();
+    let arrow = rows
+        .iter()
+        .position(|r| r.contains('▸'))
+        .expect("arrow row");
+    let first = rows
+        .iter()
+        .position(|r| r.contains("one"))
+        .expect("first label row");
+    let last = rows
+        .iter()
+        .position(|r| r.contains("eight"))
+        .expect("last label row");
+    assert!(first < last, "label lines keep their order:\n{out}");
+    assert_eq!(
+        last + 1,
+        arrow,
+        "the last label line sits right above the arrow:\n{out}"
+    );
+}
+
+#[test]
+fn wrapped_self_message_keeps_its_loop_closed() {
+    let src = "sequenceDiagram\n    participant A\n    A->>A: retry the whole operation after a short backoff\n";
+    let out = render_with_width(src, Some(24)).unwrap();
+    assert!(widest(&out) <= 24, "{out}");
+    let top = out.lines().position(|r| r.contains("├─")).expect("top leg");
+    let bottom = out
+        .lines()
+        .position(|r| r.contains("├◂"))
+        .expect("bottom leg");
+    assert!(bottom > top + 2, "loop spans several label rows:\n{out}");
+    for row in out.lines().skip(top + 1).take(bottom - top - 1) {
+        assert!(row.trim_end().ends_with('│'), "open loop wall in:\n{out}");
+    }
+}
+
+#[test]
+fn strict_mode_accepts_a_wrapped_sequence() {
+    let opts = RenderOptions {
+        max_width: Some(40),
+        max_width_strict: true,
+        ..Default::default()
+    };
+    let out = render_with_options(WIDE, &opts).expect("fits after wrapping");
+    assert!(widest(&out) <= 40);
+}
+
+#[test]
+fn impossible_budget_returns_the_narrowest_attempt_or_too_wide() {
+    let natural = widest(&render(WIDE).unwrap());
+    let soft = render_with_width(WIDE, Some(5)).unwrap();
+    assert!(
+        widest(&soft) < natural,
+        "best effort is narrower than natural"
+    );
+    let opts = RenderOptions {
+        max_width: Some(5),
+        max_width_strict: true,
+        ..Default::default()
+    };
+    assert!(matches!(
+        render_with_options(WIDE, &opts),
+        Err(Error::TooWide { requested: 5, .. })
+    ));
+}
