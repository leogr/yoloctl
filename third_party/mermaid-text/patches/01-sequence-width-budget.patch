+/// Render a [`SequenceDiagram`], fitting the output within `max_width`
+/// display columns when possible.
+///
+/// `None`, or a budget the natural layout already fits, returns exactly
+/// [`render`]'s output. Otherwise the renderer narrows the gaps between
+/// participants and wraps message labels to the room they get; further
+/// attempts tighten the participant box padding and wrap participant
+/// labels. Notes and self-message labels are wrapped to fit as well, and
+/// rows grow to hold wrapped labels. Of the attempts that fit, the one
+/// with the fewest rows (least wrapping) wins. When none fits, the
+/// narrowest one is returned (callers needing a hard limit use
+/// `RenderOptions::max_width_strict`).
+///
+/// # Examples
+///
+/// ```
+/// use mermaid_text::parser::sequence::parse;
+/// use mermaid_text::render::sequence::render_with_width;
+///
+/// let src = "sequenceDiagram\nparticipant A as Alice\nparticipant B as Bob\n\
+///            A->>B: a fairly long message label that would not fit";
+/// let out = render_with_width(&parse(src).unwrap(), Some(30));
+/// assert!(out.lines().all(|l| unicode_width::UnicodeWidthStr::width(l) <= 30));
+/// assert!(out.contains("fairly"));
+/// ```
+pub fn render_with_width(diag: &SequenceDiagram, max_width: Option<usize>) -> String {
+    let natural = render_fitted(diag, None);
+    let Some(budget) = max_width else {
+        return natural;
+    };
+    let mut best_w = max_line_width(&natural);
+    if best_w <= budget {
+        return natural;
+    }
+    let mut best = natural;
+    let widest_participant = diag
+        .participants
+        .iter()
+        .map(|p| p.label.width())
+        .max()
+        .unwrap_or(0);
+    // Attempts in order of decreasing fidelity: full padding first, then
+    // padding 1 with progressively narrower participant labels. Every word of
+    // participant and note labels is kept whole first; splitting words is
+    // the last resort, tried only when nothing fits otherwise.
+    for split_words in [false, true] {
+        let mut attempts = vec![Fit {
+            budget,
+            box_pad: BOX_PAD,
+            participant_cap: widest_participant,
+            split_words,
+        }];
+        attempts.extend((MIN_WRAP..=widest_participant).rev().map(|cap| Fit {
+            budget,
+            box_pad: 1,
+            participant_cap: cap,
+            split_words,
+        }));
+        // Among the attempts that fit, keep the shortest one: every wrapped
+        // line adds a row, so height measures how much the labels were broken
+        // up. Ties keep the earlier, less altered attempt.
+        let mut fitted: Option<(usize, String)> = None;
+        for fit in attempts {
+            let (out, w) = render_within(diag, fit);
+            if w <= budget {
+                let h = out.lines().count();
+                if fitted.as_ref().is_none_or(|(best_h, _)| h < *best_h) {
+                    fitted = Some((h, out));
+                }
+            } else if w < best_w {
+                best_w = w;
+                best = out;
+            }
+        }
+        if let Some((_, out)) = fitted {
+            return out;
+        }
+    }
+    best
+}
+
+/// Render one attempt within its budget. The layout plans the participant
+/// row to the budget, but block frames and notes may reach past that row;
+/// an attempt that comes out wider is planned again for a budget reduced by
+/// the overshoot, as long as that makes the output narrower.
+fn render_within(diag: &SequenceDiagram, fit: Fit) -> (String, usize) {
+    let mut out = render_fitted(diag, Some(fit));
+    let mut w = max_line_width(&out);
+    let mut target = fit.budget;
+    while w > fit.budget && target > MIN_WRAP {
+        let next = target.saturating_sub(w - fit.budget).max(MIN_WRAP);
+        let retry = render_fitted(
+            diag,
+            Some(Fit {
+                budget: next,
+                ..fit
+            }),
+        );
+        let retry_w = max_line_width(&retry);
+        if retry_w >= w {
+            break;
+        }
+        (out, w, target) = (retry, retry_w, next);
+    }
+    (out, w)
+}
+
+/// Display width of the widest word in `text`.
+fn widest_word(text: &str) -> usize {
+    text.split_whitespace()
+        .map(UnicodeWidthStr::width)
+        .max()
+        .unwrap_or(0)
+}
+
+/// Word-wrap `text` to `cap` display columns, splitting words that are
+/// wider than `cap` by themselves. Used only by budgeted renders.
+fn wrap_hard(text: &str, cap: usize) -> String {
+    let cap = cap.max(MIN_WRAP);
+    let wrapped = wrap_note_text(text, cap);
+    let mut out = String::with_capacity(wrapped.len());
+    for (i, line) in wrapped.split('\n').enumerate() {
+        if i > 0 {
+            out.push('\n');
+        }
+        let mut w = 0;
+        for ch in line.chars() {
+            let cw = unicode_width::UnicodeWidthChar::width(ch).unwrap_or(0);
+            if w > 0 && w + cw > cap {
+                out.push('\n');
+                w = 0;
+            }
+            out.push(ch);
+            w += cw;
+        }
+    }
+    out
+}
+
+/// Number of rows a (possibly wrapped) label occupies.
+fn line_count(text: &str) -> usize {
+    text.split('\n').count()
+}
