 ### Changed
 
+- Decision nodes (`{…}`, state `<<choice>>`) are drawn as a shallow diamond
+  instead of a box with steep `╱ ╲` corners: one-eighth horizontal lines
+  (`▁ 🭻…🭶 ▔`, the Symbols for Legacy Computing block) climb from the ends to
+  the centre, and the middle row ends in `▕ ▏`. Diamonds are at least 17
+  columns wide so the outline rises at most one eighth of a row per column.
+  Terminals or fonts without that block (e.g. Terminal.app or iTerm2 with
+  Menlo) show replacement glyphs; `--ascii` maps the outline to `- _ |`.
 - A simple top-down fan-out (one node with two or more unlabelled
   same-style edges to distinct nodes on one row, no other edge entering
   them, in a flowchart without subgraphs whose nodes are rectangles or
diff --git a/crates/mermaid-text/src/layout/grid.rs b/crates/mermaid-text/src/layout/grid.rs
index c5cf8d9..ac99e29 100644
--- a/crates/mermaid-text/src/layout/grid.rs
+++ b/crates/mermaid-text/src/layout/grid.rs
@@ -316,6 +316,10 @@ pub struct Grid {
     height: usize,
 }
 
+/// Narrowest diamond: its outline climbs the 8 one-eighth levels at most one
+/// per column on each side of the centre.
+pub const DIAMOND_MIN_WIDTH: usize = 17;
+
 /// A top or bottom border line cell: entered only by a vertical move.
 pub const SG_BORDER_H: u8 = 1;
 /// A side border line cell: entered only by a horizontal move.
@@ -963,19 +967,37 @@ impl Grid {
     ///
     /// `w` and `h` are the total bounding-box dimensions.
     pub fn draw_diamond(&mut self, col: usize, row: usize, w: usize, h: usize) {
-        if w < 2 || h < 2 {
+        if w < 4 || h < 3 {
             return;
         }
-        // Draw the standard rectangle skeleton first, then overwrite the four
-        // corner characters with diagonal glyphs.
-        self.draw_box(col, row, w, h);
-
-        // Top corners: ╱ top-left, ╲ top-right.
-        self.set(col, row, '╱');
-        self.set(col + w - 1, row, '╲');
-        // Bottom corners: ╲ bottom-left, ╱ bottom-right.
-        self.set(col, row + h - 1, '╲');
-        self.set(col + w - 1, row + h - 1, '╱');
+        // A shallow diamond: box-drawing diagonals (`╱ ╲`) are as steep as a
+        // cell is tall, so the outline is drawn with one-eighth horizontal
+        // lines instead. Along the top row it climbs from the bottom of the
+        // row (`▁`) at the ends to its top (`▔`) at the centre; the bottom row
+        // mirrors it; the middle rows end in one-eighth verticals (`▕ ▏`)
+        // that join the two rows' ends.
+        const LEVELS: [char; 8] = ['▔', '🭶', '🭷', '🭸', '🭹', '🭺', '🭻', '▁'];
+        let span = w - 3; // twice the distance from an end cell to the centre
+        for x in 1..w - 1 {
+            let d = (2 * x).abs_diff(w - 1); // twice the distance to the centre
+            let level = ((14 * d + span) / (2 * span)).min(7);
+            // Protection-respecting, like `draw_box`: an arrow tip that
+            // ends on the outline survives the redraw after routing.
+            self.set_unless_protected(col + x, row, LEVELS[level]);
+            self.set_unless_protected(col + x, row + h - 1, LEVELS[7 - level]);
+        }
+        for y in (row + 1)..(row + h - 1) {
+            self.set_unless_protected(col, y, '▕');
+            self.set_unless_protected(col + w - 1, y, '▏');
+        }
+        for (x, y) in [
+            (col, row),
+            (col + w - 1, row),
+            (col, row + h - 1),
+            (col + w - 1, row + h - 1),
+        ] {
+            self.set(x, y, ' ');
+        }
     }
 
     /// Fill a `w × h` rectangular block at `(col, row)` with full-block `█`
