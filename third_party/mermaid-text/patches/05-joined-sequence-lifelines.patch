 //! let out = render(&diag);
 //! assert!(out.contains('A'));
 //! assert!(out.contains('B'));
-//! assert!(out.contains('┆'));
+//! assert!(out.contains('│'));
 //! ```
 
 use std::{borrow::Cow, collections::BTreeMap};
@@ -93,7 +93,7 @@ const H_SOLID: char = '─';
 const H_DASH: char = '┄';
 
 /// Lifeline character.
-const LIFELINE: char = '┆';
+const LIFELINE: char = '│';
 
 // Activation bar — full-block glyph, drawn ACTIVATION_BAR_WIDTH cells
 // wide centred on the lifeline so the active span reads as a "filled
@@ -659,7 +659,7 @@ fn note_budget(
     }
 }
 
-/// Draw the lifeline `┆` column from row `start` to row `end` (inclusive).
+/// Draw the lifeline `│` column from row `start` to row `end` (inclusive).
 fn draw_lifeline(canvas: &mut Canvas, cx: usize, start: usize, end: usize) {
     for r in start..=end {
         // Only overwrite spaces — don't clobber arrow characters.
@@ -684,25 +684,51 @@ fn draw_message(
     let right = src_cx.max(tgt_cx);
     let h_char = if style.is_dashed() { H_DASH } else { H_SOLID };
 
+    // An endpoint on a bare lifeline joins it: the source with a junction,
+    // the target keeps its lifeline and takes the arrowhead in the cell next
+    // to it. Endpoints at an activation bar's edge stay plain line cells.
+    let on_lifeline = |canvas: &Canvas, c: usize| canvas.grid[row][c] == LIFELINE;
+    let left_joins = on_lifeline(canvas, left);
+    let right_joins = on_lifeline(canvas, right);
+
     // Draw horizontal line between the two lifeline columns (exclusive of
-    // the endpoint columns themselves, which are either arrowheads or line
-    // characters).
+    // the endpoint columns themselves). A lifeline it crosses becomes `┼`.
     for c in (left + 1)..right {
-        canvas.put(row, c, h_char);
+        let crossing = on_lifeline(canvas, c);
+        canvas.put(row, c, if crossing { '┼' } else { h_char });
     }
 
-    if style.has_arrow() {
+    let join = |canvas: &mut Canvas, c: usize, joins: bool, glyph: char| {
+        canvas.put(row, c, if joins { glyph } else { h_char });
+    };
+    if style.has_arrow() && right > left + 1 {
+        if going_right {
+            join(canvas, left, left_joins, '├'); // source side
+            if right_joins {
+                canvas.put(row, right - 1, ARROW_RIGHT);
+            } else {
+                canvas.put(row, right, ARROW_RIGHT);
+            }
+        } else {
+            if left_joins {
+                canvas.put(row, left + 1, ARROW_LEFT);
+            } else {
+                canvas.put(row, left, ARROW_LEFT);
+            }
+            join(canvas, right, right_joins, '┤');
+        }
+    } else if style.has_arrow() {
         if going_right {
-            canvas.put(row, left, h_char); // source side: extend line
+            canvas.put(row, left, h_char);
             canvas.put(row, right, ARROW_RIGHT);
         } else {
             canvas.put(row, left, ARROW_LEFT);
             canvas.put(row, right, h_char);
         }
     } else {
-        // No arrowhead — line extends to both endpoints.
-        canvas.put(row, left, h_char);
-        canvas.put(row, right, h_char);
+        // No arrowhead — the line joins both endpoints.
+        join(canvas, left, left_joins, '├');
+        join(canvas, right, right_joins, '┤');
     }
 
     // Label above the arrow (termaid convention). A wrapped label (budgeted
@@ -841,7 +867,7 @@ fn draw_participant_group_frame(
 /// let out = render(&diag);
 /// assert!(out.contains("hello"));
 /// assert!(out.contains("world"));
-/// assert!(out.contains('┆'));
+/// assert!(out.contains('│'));
 /// ```
 pub fn render(diag: &SequenceDiagram) -> String {
     render_fitted(diag, None)
