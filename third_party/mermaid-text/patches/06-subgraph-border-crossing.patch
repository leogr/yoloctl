+            sg_border: vec![vec![0u8; width]; height],
             width,
             height,
         }
     }
 
+    /// Whether a cell-by-cell `path` obeys the subgraph border rule that A*
+    /// applies: a border line cell is entered perpendicularly and left
+    /// straight through; corners and titles are never used. The first and
+    /// last cells (the attach points) are exempt.
+    pub(crate) fn path_respects_subgraph_borders(&self, path: &[(usize, usize)]) -> bool {
+        let last = path.len().saturating_sub(1);
+        for i in 1..last {
+            let (c, r) = path[i];
+            if r >= self.height || c >= self.width {
+                continue;
+            }
+            let kind = self.sg_border[r][c];
+            if kind == 0 {
+                continue;
+            }
+            let (pc, pr) = path[i - 1];
+            let (nc, nr) = path[i + 1];
+            let enters_vertically = pc == c && pr != r;
+            let leaves_straight = (nc as isize - c as isize, nr as isize - r as isize)
+                == (c as isize - pc as isize, r as isize - pr as isize);
+            let allowed = match kind {
+                SG_BORDER_H => enters_vertically,
+                SG_BORDER_V => !enters_vertically,
+                _ => false,
+            };
+            if !allowed || !leaves_straight {
+                return false;
+            }
+        }
+        true
+    }
+
+    /// Mark `(col, row)` as a subgraph border cell of `kind` (`SG_BORDER_*`).
+    pub fn mark_subgraph_border(&mut self, col: usize, row: usize, kind: u8) {
+        if row < self.height && col < self.width {
+            self.sg_border[row][col] = kind;
+        }
+    }
+
