+#[test]
+fn edges_never_cross_a_subgraph_title() {
+    let src = "flowchart TD
+    subgraph Frontend
+        UI[Browser UI]
+        SW[Service Worker]
+    end
+    subgraph Backend
+        API[REST API]
+    end
+    UI --> API
+    SW --> API";
+    let out = render(src).unwrap();
+    assert!(
+        out.contains("─Frontend─") && out.contains("─Backend─"),
+        "{out}"
+    );
+}
