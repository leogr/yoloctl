+//! Edges cross subgraph borders perpendicularly at one cell and never run
+//! along a border, past its corners or through its title.
+
+use mermaid_text::{RenderOptions, render, render_with_options};
+
+/// An edge that travels along a border continues past the border's rounded
+/// corner on the same row: a line glyph right after `╮`/`╯` or right before
+/// `╭`/`╰`.
+fn assert_no_edge_follows_a_border(out: &str) {
+    for line in out.lines() {
+        let chars: Vec<char> = line.chars().collect();
+        for (i, &c) in chars.iter().enumerate() {
+            let next = chars.get(i + 1).copied();
+            let prev = i.checked_sub(1).map(|j| chars[j]);
+            let line_glyph = |g: Option<char>| matches!(g, Some('─' | '┄' | '━' | '┼' | '┬' | '┴'));
+            assert!(
+                !(matches!(c, '╮' | '╯') && line_glyph(next)),
+                "an edge continues past a subgraph corner:\n{out}"
+            );
+            assert!(
+                !(matches!(c, '╭' | '╰') && line_glyph(prev)),
+                "an edge continues past a subgraph corner:\n{out}"
+            );
+        }
+    }
+}
+
+const HOST_VM: &str = "flowchart LR
+    subgraph Host
+        CLI[yoloctl CLI] --> TUI[TUI]
+    end
+    subgraph VM
+        CTL[controller] --> BOX1[box coder]
+        CTL --> BOX2[box reviewer]
+    end
+    CLI --> CTL
+    TUI --> CTL";
+
+#[test]
+fn edges_leaving_a_subgraph_cross_its_border() {
+    let natural = render(HOST_VM).unwrap();
+    assert_no_edge_follows_a_border(&natural);
+    for width in [40, 60, 80] {
+        let opts = RenderOptions {
+            max_width: Some(width),
+            ..Default::default()
+        };
+        let out = render_with_options(HOST_VM, &opts).unwrap();
+        assert_no_edge_follows_a_border(&out);
+        assert!(out.contains("Host") && out.contains("VM"), "{out}");
+    }
+}
+
+#[test]
+fn edges_leaving_a_nested_subgraph_cross_both_borders() {
+    let src = "flowchart TD
+    subgraph Outer
+        subgraph Inner
+            A[inside] --> B[also inside]
+        end
+        C[outer node]
+    end
+    A --> D[outside]
+    B --> C
+    C --> D";
+    let out = render(src).unwrap();
+    assert_no_edge_follows_a_border(&out);
+    for label in ["inside", "also inside", "outer node", "outside"] {
+        assert!(out.contains(label), "{label} missing:\n{out}");
+    }
+}
