         self.height
@@ -1538,6 +1557,24 @@ impl Grid {
                         continue;
                     }
                 }
+                // Subgraph borders: cross one cell perpendicularly, never
+                // travel along them, never through a corner or the title.
+                let goal = nc == col2 && nr == row2;
+                let vertical_move = dir_idx == 1 || dir_idx == 3;
+                if !goal {
+                    match self.sg_border[nr][nc] {
+                        SG_BORDER_H if !vertical_move => continue,
+                        SG_BORDER_V if vertical_move => continue,
+                        SG_BORDER_CLOSED => continue,
+                        _ => {}
+                    }
+                }
+                if self.sg_border[current.row][current.col] != 0
+                    && (current.col != col1 || current.row != row1)
+                    && dir_idx as u8 != current.dir
+                {
+                    continue; // leave a border cell straight through
+                }
 
                 // Base step cost.
                 let mut step = 1.0f32;
