+//! A simple TD fan-out is drawn as one trunk, a bar and drops; every other
+//! fan-out keeps the routing it had before (expected outputs below were
+//! rendered by the previous release of this patch stack).
+
+use mermaid_text::render;
+
+#[test]
+fn simple_fan_out_shares_one_trunk() {
+    let src = "graph TD\n    coord[Coordinator] --> a[astra] & s[sol-dev] & s2[sol-dev2] & o[opus-dev] & d[devOpSol]";
+    let out = render(src).unwrap();
+    assert_eq!(
+        out.trim_end(),
+        "                            ┌─────────────┐\n                            │ Coordinator │\n                            └─────────────┘\n      ┌────────────┬──────────────┼──────────────┬──────────────┐\n      │            │              │              │              │\n      │            │              │              │              │\n      │            │              │              │              │\n      │            │              │              │              │\n  ┌───▾───┐   ┌────▾────┐   ┌─────▾────┐   ┌─────▾────┐   ┌─────▾────┐\n  │ astra │   │ sol-dev │   │ sol-dev2 │   │ opus-dev │   │ devOpSol │\n  └───────┘   └─────────┘   └──────────┘   └──────────┘   └──────────┘",
+        "\n{out}"
+    );
+    assert_eq!(out.matches('┼').count(), 1, "one trunk junction:\n{out}");
+}
+
+#[test]
+fn labelled_fan_out_keeps_its_routing() {
+    let out = render(
+        "graph TD
+ A[Root] --> B[one]
+ A -->|x| C[two]
+ A --> D[three]",
+    )
+    .unwrap();
+    assert_eq!(
+        out.trim_end(),
+        "                ┌──────┐
+                │ Root │
+                └──────┘
+         ┌────────┘ │ └───────┐
+         │          │         │
+         │          │         │
+         │        x │         │
+         │          │         │
+         │          │         │
+         │         ┌┘         │
+      ┌──▾──┐   ┌──▾──┐   ┌───▾───┐
+      │ one │   │ two │   │ three │
+      └─────┘   └─────┘   └───────┘",
+        "\n{out}"
+    );
+}
+
+#[test]
+fn mixed_style_fan_out_keeps_its_routing() {
+    let out = render(
+        "graph TD
+ A[Root] --> B[one]
+ A -.-> C[two]
+ A --> D[three]",
+    )
+    .unwrap();
+    assert_eq!(
+        out.trim_end(),
+        "            ┌──────┐
+            │ Root │
+            └──────┘
+     ┌────────┘ ┆ └───────┐
+     │          ┆         │
+     │          ┆         │
+     │          ┆         │
+     │         ┌┘         │
+  ┌──▾──┐   ┌──▾──┐   ┌───▾───┐
+  │ one │   │ two │   │ three │
+  └─────┘   └─────┘   └───────┘",
+        "\n{out}"
+    );
+}
+
+#[test]
+fn cross_layer_fan_out_keeps_its_routing() {
+    let out = render(
+        "graph TD
+ A[Root] --> B[one]
+ B --> C[two]
+ A --> C
+ A --> D[three]",
+    )
+    .unwrap();
+    assert_eq!(
+        out.trim_end(),
+        "          ┌──────┐
+          │ Root │
+          └──────┘
+     ┌──────┘ └┐└─────┐
+     │         │      │
+     │         │      │
+     │         │      │
+     │         │      │
+  ┌──▾──┐      │  ┌───▾───┐
+  │ one │      │  │ three │
+  └─────┘      │  └───────┘
+     └───────┐ │
+             │ │
+             │ │
+             │ │
+             │ │
+           ┌─▾─▾─┐
+           │ two │
+           └─────┘",
+        "\n{out}"
+    );
+}
+
+#[test]
+fn fan_out_into_shared_targets_keeps_its_routing() {
+    let out = render(
+        "graph TD
+ A[Root] --> B[one]
+ A --> C[two]
+ X[other] --> B",
+    )
+    .unwrap();
+    assert_eq!(
+        out.trim_end(),
+        "  ┌──────┐   ┌───────┐
+  │ Root │   │ other │
+  └──────┘   └───────┘
+     └─┬───────┐ │
+       │       │ │
+       │       │ │
+       │       │ │
+      ┌┘       │ │
+   ┌──▾──┐   ┌─▾─▾─┐
+   │ two │   │ one │
+   └─────┘   └─────┘",
+        "\n{out}"
+    );
+}
+
+#[test]
+fn obstructed_corridor_keeps_its_routing() {
+    let out = render(
+        "graph TD
+ S[a wide sibling node with a long label] --> T[t]
+ A[Root] --> B[one]
+ A --> C[two]",
+    )
+    .unwrap();
+    assert_eq!(
+        out.trim_end(),
+        "  ┌───────────────────────────────────────┐   ┌──────┐
+  │ a wide sibling node with a long label │   │ Root │
+  └───────────────────────────────────────┘   └──────┘
+                 ┌────┘             ┌────────────┬─┘
+                 │                  │            │
+                 │                  │            │
+                 │             ┌────┼────┐       │
+                 │        ┌────┘    │    └───────┘
+               ┌─▾─┐   ┌──▾──┐   ┌──▾──┐
+               │ t │   │ one │   │ two │
+               └───┘   └─────┘   └─────┘",
+        "\n{out}"
+    );
+}
