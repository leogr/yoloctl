+/// Paths for the simple TD fan-outs drawn as a shared trunk: from the
+/// source's exit row, a bar spanning the targets' columns, and a drop into
+/// each target. A fan-out qualifies when the graph is TD without subgraphs,
+/// its nodes are rectangles or cylinders, and the source has two or more
+/// forward edges to distinct targets on one row, all with the same style
+/// and endpoints and no label, while no other forward edge enters those
+/// targets. The trunk, bar and drops must be clear of node boxes and text;
+/// otherwise that fan-out keeps the ordinary routing.
+fn fan_out_trunks(
+    grid: &Grid,
+    graph: &Graph,
+    attach_points: &[Option<(Attach, Attach)>],
+    is_back: &impl Fn(usize) -> bool,
+) -> Vec<(usize, Vec<(usize, usize)>)> {
+    let simple = graph.direction == Direction::TopToBottom
+        && graph.subgraphs.is_empty()
+        && graph
+            .nodes
+            .iter()
+            .all(|node| matches!(node.shape, NodeShape::Rectangle | NodeShape::Cylinder));
+    if !simple {
+        return Vec::new();
+    }
+    let forward = |idx: usize| {
+        let edge = &graph.edges[idx];
+        edge.from != edge.to && !is_back(idx) && attach_points.get(idx).is_some_and(Option::is_some)
+    };
+    let mut groups: Vec<(&str, Vec<usize>)> = Vec::new();
+    for (idx, edge) in graph.edges.iter().enumerate() {
+        if !forward(idx) {
+            continue;
+        }
+        match groups.iter_mut().find(|(from, _)| *from == edge.from) {
+            Some((_, members)) => members.push(idx),
+            None => groups.push((edge.from.as_str(), vec![idx])),
+        }
+    }
+    let mut out = Vec::new();
+    for (_, members) in groups {
+        if members.len() < 2 {
+            continue;
+        }
+        let first = &graph.edges[members[0]];
+        let alike = members.iter().all(|&idx| {
+            let edge = &graph.edges[idx];
+            edge.label.is_none()
+                && edge.style == first.style
+                && edge.end == first.end
+                && edge.start == first.start
+        });
+        let mut targets: Vec<&str> = members
+            .iter()
+            .map(|&idx| graph.edges[idx].to.as_str())
+            .collect();
+        targets.sort_unstable();
+        let distinct = targets.windows(2).all(|w| w[0] != w[1]);
+        let others_enter = graph.edges.iter().enumerate().any(|(idx, edge)| {
+            !members.contains(&idx) && forward(idx) && targets.contains(&edge.to.as_str())
+        });
+        if !alike || !distinct || others_enter {
+            continue;
+        }
+        let ends: Vec<(Attach, Attach)> = members
+            .iter()
+            .filter_map(|&idx| attach_points[idx])
+            .collect();
+        let bar_row = ends[0].0.row;
+        let target_row = ends[0].1.row;
+        if ends
+            .iter()
+            .any(|(src, dst)| src.row != bar_row || dst.row != target_row)
+            || target_row <= bar_row
+        {
+            continue;
+        }
+        let lo = ends.iter().map(|(src, _)| src.col).min().unwrap_or(0);
+        let hi = ends.iter().map(|(src, _)| src.col).max().unwrap_or(0);
+        // Under the source's centre, or on the target column nearest to it
+        // when that column is also under the source, so a drop continues
+        // the trunk straight.
+        let centre = (lo + hi) / 2;
+        let trunk = ends
+            .iter()
+            .map(|(_, dst)| dst.col)
+            .filter(|col| (lo..=hi).contains(col))
+            .min_by_key(|col| col.abs_diff(centre))
+            .unwrap_or(centre);
+        let group: Vec<(usize, Vec<(usize, usize)>)> = members
+            .iter()
+            .zip(&ends)
+            .map(|(&idx, (_, dst))| {
+                // Every cell: along the bar to the target's column, then down.
+                let mut path: Vec<(usize, usize)> = if dst.col >= trunk {
+                    (trunk..=dst.col).map(|c| (c, bar_row)).collect()
+                } else {
+                    (dst.col..=trunk).rev().map(|c| (c, bar_row)).collect()
+                };
+                path.extend((bar_row + 1..=dst.row).map(|r| (dst.col, r)));
+                (idx, path)
+            })
+            .collect();
+        // The source box: the run of box cells right above the trunk.
+        let above = bar_row.checked_sub(1);
+        let mut source_lo = trunk;
+        let mut source_hi = trunk;
+        if let Some(row) = above {
+            while source_lo > 0 && grid.is_node_box(source_lo - 1, row) {
+                source_lo -= 1;
+            }
+            while grid.is_node_box(source_hi + 1, row) {
+                source_hi += 1;
+            }
+        }
+        let foreign_box = |c: usize, r: usize| {
+            grid.is_node_box(c, r) && !(Some(r) == above && (source_lo..=source_hi).contains(&c))
+        };
+        let clear = group.iter().all(|(_, path)| {
+            let goal = path.last().copied();
+            path.iter().all(|&(c, r)| {
+                if Some((c, r)) == goal {
+                    return true;
+                }
+                let free = !grid.is_node_box(c, r) && grid.get(c, r) == ' ';
+                // Not touching an unrelated node: above/below the bar, beside
+                // a drop (it would read as welded to that box).
+                let touching = if r == bar_row {
+                    above.is_some_and(|a| foreign_box(c, a))
+                        || foreign_box(c, r + 1) && Some((c, r + 1)) != goal
+                } else {
+                    c.checked_sub(1).is_some_and(|l| foreign_box(l, r)) || foreign_box(c + 1, r)
+                };
+                free && !touching
+            })
+        });
+        if clear {
+            out.extend(group);
+        }
+    }
+    out
+}
