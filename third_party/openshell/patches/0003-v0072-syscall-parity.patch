+    // yoloctl: calls v0.0.72 allowed stay usable with no-op arguments under
+    // the child filter (GNU make's posix_spawn RESETIDS, nice, ulimit).
+    #[test]
+    fn filter_allows_v0_0_72_identity_priority_and_limit_calls() {
+        // SAFETY: the child uses only raw syscalls after fork and exits with
+        // `_exit`, so it does not run copied Rust cleanup state.
+        let child = unsafe { libc::fork() };
+        assert!(child >= 0, "fork: {}", io::Error::last_os_error());
+        if child == 0 {
+            let sandbox_tgid = unsafe { libc::getppid() };
+            let Ok(mut filter) = prepare(u32::try_from(sandbox_tgid).unwrap_or(0)) else {
+                unsafe { libc::_exit(1) };
+            };
+            if filter.install().is_err() {
+                unsafe { libc::_exit(2) };
+            }
+            let (uid, gid) = unsafe { (libc::getuid(), libc::getgid()) };
+            if unsafe { libc::setgid(gid) } != 0 || unsafe { libc::setuid(uid) } != 0 {
+                unsafe { libc::_exit(3) };
+            }
+            let unchanged = u32::MAX; // -1: keep each ID
+            let setresuid =
+                unsafe { libc::syscall(libc::SYS_setresuid, unchanged, unchanged, unchanged) };
+            let setresgid =
+                unsafe { libc::syscall(libc::SYS_setresgid, unchanged, unchanged, unchanged) };
+            if setresuid != 0 || setresgid != 0 {
+                unsafe { libc::_exit(4) };
+            }
+            let priority = unsafe { libc::getpriority(libc::PRIO_PROCESS, 0) };
+            if unsafe { libc::setpriority(libc::PRIO_PROCESS, 0, priority) } != 0 {
+                unsafe { libc::_exit(5) };
+            }
+            let mut limit = libc::rlimit { rlim_cur: 0, rlim_max: 0 };
+            let me = unsafe { libc::getpid() };
+            let read = unsafe {
+                libc::syscall(
+                    libc::SYS_prlimit64,
+                    me,
+                    libc::RLIMIT_NOFILE,
+                    std::ptr::null::<libc::rlimit>(),
+                    &raw mut limit,
+                )
+            };
+            let write = unsafe {
+                libc::syscall(
+                    libc::SYS_prlimit64,
+                    me,
+                    libc::RLIMIT_NOFILE,
+                    &raw const limit,
+                    std::ptr::null_mut::<libc::rlimit>(),
+                )
+            };
+            if read != 0 || write != 0 {
+                unsafe { libc::_exit(6) };
+            }
+            let mut set = unsafe { std::mem::zeroed::<libc::cpu_set_t>() };
+            let size = std::mem::size_of::<libc::cpu_set_t>();
+            if unsafe { libc::sched_getaffinity(me, size, &raw mut set) } != 0
+                || unsafe { libc::sched_setaffinity(me, size, &raw const set) } != 0
+            {
+                unsafe { libc::_exit(7) };
+            }
+            const IOPRIO_WHO_PROCESS: libc::c_long = 1;
+            let ioprio = unsafe { libc::syscall(libc::SYS_ioprio_get, IOPRIO_WHO_PROCESS, 0) };
+            let restored =
+                unsafe { libc::syscall(libc::SYS_ioprio_set, IOPRIO_WHO_PROCESS, 0, ioprio) };
+            if ioprio < 0 || restored != 0 {
+                unsafe { libc::_exit(8) };
+            }
+            // Process-group signals (kill(0), killpg) as in v0.0.72.
+            if unsafe { libc::setpgid(0, 0) } != 0
+                || unsafe { libc::kill(0, 0) } != 0
+                || unsafe { libc::killpg(libc::getpgrp(), 0) } != 0
+            {
+                unsafe { libc::_exit(9) };
+            }
+            unsafe { libc::_exit(0) };
+        }
+
+        let mut status = 0;
+        // SAFETY: `child` names our live direct child and status is writable.
+        assert_eq!(unsafe { libc::waitpid(child, &raw mut status, 0) }, child);
+        assert!(libc::WIFEXITED(status));
+        assert_eq!(libc::WEXITSTATUS(status), 0);
+    }
