+    /// yoloctl: run one notified scheduling call from a filtered worker thread
+    /// and mediate it with `sandbox_tgid`; return (mediator errno, result).
+    fn notified(syscall: i64, args: [libc::c_long; 3], sandbox_tgid: u32) -> (Option<i32>, i64) {
+        let (sender, receiver) = std::sync::mpsc::sync_channel(1);
+        let worker = std::thread::spawn(move || {
+            let listener = crate::linux::seccomp_notify::install_workload_listener().unwrap();
+            sender.send(listener).unwrap();
+            // SAFETY: scalar arguments only.
+            unsafe { libc::syscall(syscall, args[0], args[1], args[2]) }
+        });
+        let listener = receiver
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .unwrap();
+        let notification = listener.receive().unwrap();
+        let errno = match mediate_process_sched(&listener, notification, sandbox_tgid) {
+            Ok(()) => None,
+            Err(error) => {
+                let errno = error.raw_os_error().unwrap_or(libc::EIO);
+                listener.respond_errno(notification.id, errno).unwrap();
+                Some(errno)
+            }
+        };
+        (errno, worker.join().unwrap())
+    }
