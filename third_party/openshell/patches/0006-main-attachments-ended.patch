+/// yoloctl patch 0006: the file beside the exit marker that records that no
+/// client is attached to the canonical main process any more.
+const MAIN_ATTACHMENTS_ENDED_FILE: &str = "main-attachments-ended";
+
+/// yoloctl patch 0006: waits for terminal delivery to drain (every attachment
+/// present at the exit has ended; in russh that is its connection ending),
+/// then publishes `main-attachments-ended` beside the exit marker. The file
+/// does not tell completion from abandonment. A drain cancelled by shutdown
+/// writes nothing. Returns whether shutdown cancelled the drain.
+async fn drain_then_mark_attachments_ended<F, S>(
+    drain: F,
+    shutdown: Pin<&mut S>,
+    main_exit_marker: Option<&std::path::Path>,
+) -> bool
+where
+    F: Future<Output = ()>,
+    S: Future<Output = ()> + ?Sized,
+{
+    let cancelled = completion_phase_or_shutdown(drain, shutdown).await;
+    if !cancelled
+        && let Some(marker) = main_exit_marker
+        && let Err(error) = persist_main_attachments_ended(marker)
+    {
+        // The reader's bound still ends the wait without this file.
+        warn!(error = %error, "failed to persist canonical-process attachments-ended marker");
+    }
+    cancelled
+}
+
+fn persist_main_attachments_ended(main_exit_marker: &std::path::Path) -> std::io::Result<()> {
+    write_private_file_atomically(
+        &main_exit_marker.with_file_name(MAIN_ATTACHMENTS_ENDED_FILE),
+        b"ended\n",
+    )
+}
