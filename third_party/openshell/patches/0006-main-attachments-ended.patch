+    // yoloctl patch 0006: `main-attachments-ended` is written beside the exit marker
+    // once the drain completes, and never when shutdown cancels the drain; the
+    // exit marker is untouched in every case.
+    async fn delivery_case(
+        drain: impl Future<Output = ()>,
+        shutdown: impl Future<Output = ()>,
+    ) -> (bool, tempfile::TempDir) {
+        let directory = tempfile::tempdir().unwrap();
+        let marker = directory.path().join("main-exited");
+        persist_main_exit_marker(&marker, 7).unwrap();
+        tokio::pin!(shutdown);
+        let cancelled = drain_then_mark_attachments_ended(drain, shutdown, Some(&marker)).await;
+        assert_eq!(std::fs::read_to_string(&marker).unwrap(), "exit_code=7\n");
+        (cancelled, directory)
+    }
+
+    fn attachments_ended(directory: &tempfile::TempDir) -> Option<String> {
+        std::fs::read_to_string(directory.path().join(MAIN_ATTACHMENTS_ENDED_FILE)).ok()
+    }
+
+    #[tokio::test]
+    async fn main_attachments_ended_is_written_at_once_without_attachments() {
+        let (cancelled, directory) =
+            delivery_case(std::future::ready(()), std::future::pending()).await;
+        assert!(!cancelled);
+        assert_eq!(attachments_ended(&directory).as_deref(), Some("ended\n"));
+        assert!(
+            !directory
+                .path()
+                .join(format!(
+                    ".main-attachments-ended.tmp-{}",
+                    std::process::id()
+                ))
+                .exists()
+        );
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt as _;
+            let mode = std::fs::metadata(directory.path().join(MAIN_ATTACHMENTS_ENDED_FILE))
+                .unwrap()
+                .permissions()
+                .mode();
+            assert_eq!(mode & 0o777, 0o600);
+        }
+    }
+
+    #[tokio::test]
+    async fn main_attachments_ended_waits_for_the_drain() {
+        let directory = tempfile::tempdir().unwrap();
+        let marker = directory.path().join("main-exited");
+        let (release, released) = tokio::sync::oneshot::channel::<()>();
+        let drain = async move {
+            let _ = released.await;
+        };
+        let shutdown = std::future::pending::<()>();
+        tokio::pin!(shutdown);
+        let task = drain_then_mark_attachments_ended(drain, shutdown, Some(&marker));
+        tokio::pin!(task);
+        assert!(timeout(Duration::from_millis(20), &mut task).await.is_err());
+        assert!(!directory.path().join(MAIN_ATTACHMENTS_ENDED_FILE).exists());
+        release.send(()).unwrap();
+        assert!(!task.await);
+        assert_eq!(
+            std::fs::read_to_string(directory.path().join(MAIN_ATTACHMENTS_ENDED_FILE)).unwrap(),
+            "ended\n"
+        );
+    }
+
+    #[tokio::test]
+    async fn main_attachments_ended_is_not_written_when_shutdown_cancels_the_drain() {
+        let (cancelled, directory) =
+            delivery_case(std::future::pending(), std::future::ready(())).await;
+        assert!(cancelled);
+        assert_eq!(attachments_ended(&directory), None);
+    }
+
+    #[tokio::test]
+    async fn main_attachments_ended_replaces_a_stale_file_and_needs_a_marker() {
+        let directory = tempfile::tempdir().unwrap();
+        let marker = directory.path().join("main-exited");
+        std::fs::write(directory.path().join(MAIN_ATTACHMENTS_ENDED_FILE), b"stale").unwrap();
+        let shutdown = std::future::pending::<()>();
+        tokio::pin!(shutdown);
+        assert!(
+            !drain_then_mark_attachments_ended(std::future::ready(()), shutdown, Some(&marker))
+                .await
+        );
+        assert_eq!(
+            std::fs::read_to_string(directory.path().join(MAIN_ATTACHMENTS_ENDED_FILE)).unwrap(),
+            "ended\n"
+        );
+        let shutdown = std::future::pending::<()>();
+        tokio::pin!(shutdown);
+        assert!(!drain_then_mark_attachments_ended(std::future::ready(()), shutdown, None).await);
+    }
