+/// Check explicit read-only workspace intent without touching the filesystem.
+/// Component, traversal and write-probe checks remain boundary-owned.
+pub fn validate_workspace_read_only(workdir: Option<&str>, read_only: bool) -> Result<(), String> {
+    if !read_only {
+        return Ok(());
+    }
+    let root = workdir.ok_or("read-only workspace requires an explicit workdir")?;
+    let resolved = openshell_core::driver_mounts::resolve_oci_workspace_root(root)?;
+    if root.is_empty() || root != resolved {
+        return Err("read-only workspace requires an explicit normalized absolute workdir".into());
+    }
+    Ok(())
+}
+
 pub mod contract;
