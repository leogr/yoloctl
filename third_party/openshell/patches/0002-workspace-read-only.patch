+#[cfg(test)]
+mod workspace_read_only_tests {
+    use super::*;
+
+    #[test]
+    fn workspace_read_only_requires_an_explicit_valid_path_only_when_true() {
+        for root in [
+            None,
+            Some(""),
+            Some("/"),
+            Some("relative"),
+            Some("/a/../b"),
+            Some("/a//b"),
+            Some("/a\0b"),
+        ] {
+            assert!(
+                validate_workspace_read_only(root, true).is_err(),
+                "{root:?}"
+            );
+            assert!(
+                validate_workspace_read_only(root, false).is_ok(),
+                "legacy {root:?}"
+            );
+        }
+        for root in ["/sandbox", "/workdir", "/workdir/project"] {
+            assert!(
+                validate_workspace_read_only(Some(root), true).is_ok(),
+                "{root}"
+            );
+        }
+    }
+}
