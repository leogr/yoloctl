+    /// yoloctl: run one notified `kill` from a filtered worker thread and
+    /// return (mediator errno, worker result, worker errno).
+    fn notified_kill(
+        target: i32,
+        signal: i32,
+        sandbox_tgid: u32,
+    ) -> (Option<i32>, i64, Option<i32>) {
+        let (sender, receiver) = std::sync::mpsc::sync_channel(1);
+        let worker = std::thread::spawn(move || {
+            let listener =
+                crate::linux::seccomp_notify::install_workload_listener_with(true).unwrap();
+            sender.send(listener).unwrap();
+            // SAFETY: scalar arguments only.
+            let result = unsafe { libc::syscall(libc::SYS_kill, target, signal) };
+            (result, io::Error::last_os_error().raw_os_error())
+        });
+        let listener = receiver
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .unwrap();
+        let notification = listener.receive().unwrap();
+        let mediated = mediate_process_signal(
+            &listener,
+            notification,
+            sandbox_tgid,
+            &AtomicBool::new(false),
+        );
+        let mediated_errno = match mediated {
+            Ok(()) => None,
+            Err(error) => {
+                let errno = error.raw_os_error().unwrap_or(libc::EIO);
+                listener.respond_errno(notification.id, errno).unwrap();
+                Some(errno)
+            }
+        };
+        let (result, errno) = worker.join().unwrap();
+        (mediated_errno, result, errno)
+    }
+
+    fn own_group_sleeper() -> std::process::Child {
+        use std::os::unix::process::CommandExt;
+        std::process::Command::new("sleep")
+            .arg("30")
+            .process_group(0)
+            .spawn()
+            .unwrap()
+    }
