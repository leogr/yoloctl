+/// yoloctl: deliver a process-group `kill` (PID zero means the caller's own
+/// group) unless the group is the sandbox's own, 0 or 1. The group is resolved
+/// once here and the broker signals that numeric group itself, so a later
+/// `setpgid` by the caller cannot redirect the signal into the sandbox's
+/// group; the workload cannot move the sandbox into another group. Broadcast
+/// (-1) and queued group signals stay denied by the caller above.
+fn mediate_group_signal(
+    listener: &NotificationListener,
+    notification: Notification,
+    target: i32,
+    signal: i32,
+    sandbox_tgid: u32,
+    workload_frozen: &AtomicBool,
+) -> io::Result<()> {
+    let group = if target == 0 {
+        let tid = i32::try_from(notification.tid)
+            .map_err(|_| io::Error::from_raw_os_error(libc::ESRCH))?;
+        // SAFETY: getpgid takes a scalar PID and has no side effects.
+        let caller_group = unsafe { libc::getpgid(tid) };
+        if caller_group < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        caller_group
+    } else {
+        target
+            .checked_neg()
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::EINVAL))?
+    };
+    let sandbox =
+        i32::try_from(sandbox_tgid).map_err(|_| io::Error::from_raw_os_error(libc::EINVAL))?;
+    // SAFETY: getpgid takes a scalar PID and has no side effects.
+    let sandbox_group = unsafe { libc::getpgid(sandbox) };
+    if sandbox_group < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if group <= 1 || group == sandbox_group || group == sandbox {
+        return Err(io::Error::from_raw_os_error(libc::EPERM));
+    }
+    refuse_resume_while_frozen(signal, workload_frozen)?;
+    listener.validate_id(notification.id)?;
+    // SAFETY: scalar arguments; the target is a validated process group.
+    if unsafe { libc::kill(-group, signal) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    listener.respond_value(notification.id, 0)
+}
