+        let own_group = unsafe { libc::getpgrp() };
+        for target in [-own_group, 0, -1] {
+            let (mediated, result, errno) = notified_kill(target, 0, std::process::id());
+            assert_eq!(
+                (mediated, result, errno),
+                (Some(libc::EPERM), -1, Some(libc::EPERM)),
+                "target {target}"
+            );
+        }
+    }
