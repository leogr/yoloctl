+    // Requests OPENSHELL_MAIN_RAW_INPUT=1 (and optionally read-only) and the
+    // openshell-main subsystem, then asserts the refusal: the request itself
+    // fails before the diagnostic, exit status 1 and close.
+    async fn assert_raw_input_refused(
+        main_session: Option<Arc<MainSession>>,
+        read_only: bool,
+        message: &str,
+    ) {
+        let client = main_test_client(main_session).await;
+        let mut channel = client.channel_open_session().await.unwrap();
+        let mut env = vec![("OPENSHELL_MAIN_RAW_INPUT", "1")];
+        if read_only {
+            env.push(("OPENSHELL_MAIN_READ_ONLY", "1"));
+        }
+        for (name, value) in env {
+            channel.set_env(true, name, value).await.unwrap();
+            assert!(matches!(
+                next_main_event(&mut channel).await,
+                russh::ChannelMsg::Success
+            ));
+        }
+        channel
+            .request_subsystem(true, "openshell-main")
+            .await
+            .unwrap();
+        match next_main_event(&mut channel).await {
+            russh::ChannelMsg::Failure => {}
+            event => panic!("a raw-input refusal must fail the request, got {event:?}"),
+        }
+        match next_main_event(&mut channel).await {
+            russh::ChannelMsg::ExtendedData { data, ext: 1 } => assert_eq!(
+                String::from_utf8_lossy(&data),
+                format!("openshell: cannot connect to the canonical main process: {message}\n")
+            ),
+            event => panic!("expected refusal diagnostic, got {event:?}"),
+        }
+        assert!(matches!(
+            next_main_event(&mut channel).await,
+            russh::ChannelMsg::ExitStatus { exit_status: 1 }
+        ));
+        assert!(matches!(
+            next_main_event(&mut channel).await,
+            russh::ChannelMsg::Eof
+        ));
+        assert!(matches!(
+            next_main_event(&mut channel).await,
+            russh::ChannelMsg::Close
+        ));
+    }
