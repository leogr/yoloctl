+/// yoloctl patch 0005: refuses a raw-input main attachment. The request
+/// fails before any diagnostic, so a client never mistakes the refusal for an
+/// attachment that owns stdin.
+fn refuse_raw_main(
+    session: &mut Session,
+    channel: ChannelId,
+    error: impl std::fmt::Display,
+    line_ending: &str,
+) -> anyhow::Result<()> {
+    session.channel_failure(channel)?;
+    session.extended_data(
+        channel,
+        1,
+        format!("openshell: cannot connect to the canonical main process: {error}{line_ending}")
+            .into_bytes(),
+    )?;
+    session.exit_status_request(channel, 1)?;
+    session.eof(channel)?;
+    session.close(channel)?;
+    Ok(())
+}
