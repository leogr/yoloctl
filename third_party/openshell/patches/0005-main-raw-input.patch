+    async fn raw_input_attachment(
+        main_session: &Arc<MainSession>,
+    ) -> russh::Channel<russh::client::Msg> {
+        let client = main_test_client(Some(main_session.clone())).await;
+        let mut channel = client.channel_open_session().await.unwrap();
+        channel
+            .set_env(true, "OPENSHELL_MAIN_RAW_INPUT", "1")
+            .await
+            .unwrap();
+        assert!(matches!(
+            next_main_event(&mut channel).await,
+            russh::ChannelMsg::Success
+        ));
+        channel
+            .request_subsystem(true, "openshell-main")
+            .await
+            .unwrap();
+        assert!(matches!(
+            next_main_event(&mut channel).await,
+            russh::ChannelMsg::Success
+        ));
+        channel
+    }
+
+    // yoloctl patch 0005: with OPENSHELL_MAIN_RAW_INPUT=1 every byte, Ctrl-D,
+    // a lone Ctrl-P and Ctrl-P Ctrl-Q included, reaches the main process in
+    // order and the attachment stays open.
+    #[tokio::test]
+    async fn main_attachment_raw_input_forwards_every_byte() {
+        let (main_session, mut input) = MainSession::inert_with_input();
+        let mut channel = raw_input_attachment(&main_session).await;
+        let all: Vec<u8> = (0..=255).collect();
+        let mut sent = Vec::new();
+        for frame in [
+            &b"\x04"[..],
+            b"\x10",
+            b"\x10\x11",
+            b"a\x10\x11b\x04c",
+            &all[..],
+        ] {
+            channel.data(frame).await.unwrap();
+            sent.extend_from_slice(frame);
+        }
+        let mut received = Vec::new();
+        while received.len() < sent.len() {
+            let chunk = tokio::time::timeout(Duration::from_secs(5), input.recv())
+                .await
+                .expect("raw input must reach the main process")
+                .expect("main stdin channel open");
+            received.extend_from_slice(&chunk);
+        }
+        assert_eq!(received, sent);
+        assert!(!main_session.finished());
+        assert!(
+            main_session.acquire_input().is_err(),
+            "the raw attachment still owns stdin"
+        );
+        assert!(
+            tokio::time::timeout(Duration::from_millis(200), channel.wait())
+                .await
+                .is_err(),
+            "the raw attachment must stay open"
+        );
+    }
+
+    // A raw-input attachment that cannot own stdin is refused, never a viewer.
+    #[tokio::test]
+    async fn main_attachment_raw_input_is_refused_without_stdin() {
+        let main_session = MainSession::inert();
+        let (owner, _input) = main_session.acquire_input().unwrap();
+        let client = main_test_client(Some(main_session.clone())).await;
+        let mut channel = client.channel_open_session().await.unwrap();
+        channel
+            .set_env(true, "OPENSHELL_MAIN_RAW_INPUT", "1")
+            .await
+            .unwrap();
+        assert!(matches!(
+            next_main_event(&mut channel).await,
+            russh::ChannelMsg::Success
+        ));
+        channel
+            .request_subsystem(true, "openshell-main")
+            .await
+            .unwrap();
+        assert!(matches!(
+            next_main_event(&mut channel).await,
+            russh::ChannelMsg::Success
+        ));
+        match next_main_event(&mut channel).await {
+            russh::ChannelMsg::ExtendedData { data, ext: 1 } => assert_eq!(
+                String::from_utf8_lossy(&data),
+                "openshell: cannot connect to the canonical main process: canonical main process already has an input owner\n"
+            ),
+            event => panic!("expected refusal, got {event:?}"),
+        }
+        assert!(matches!(
+            next_main_event(&mut channel).await,
+            russh::ChannelMsg::ExitStatus { exit_status: 1 }
+        ));
+        assert!(
+            main_session.acquire_input().is_err(),
+            "a refusal must not touch the owner's lease"
+        );
+        main_session.release_input(owner);
+    }
