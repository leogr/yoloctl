+    // A raw-input attachment that cannot own stdin is refused, never a viewer:
+    // the request fails and the owner's lease is untouched.
+    #[tokio::test]
+    async fn main_attachment_raw_input_is_refused_without_stdin() {
+        let main_session = MainSession::inert();
+        let (owner, _input) = main_session.acquire_input().unwrap();
+        assert_raw_input_refused(
