+        finish.await.unwrap();
+        assert!(session.finished());
+        let session = MainSession::inert();
+        session.readers_remaining.store(1, Ordering::Release);
+        let ending = session.clone();
+        let finish = tokio::spawn(async move { ending.finish_remote(3, false).await });
+        tokio::task::yield_now().await;
+        finish.abort();
+        assert!(finish.await.unwrap_err().is_cancelled());
+        assert!(!session.finished());
+    }
+
+    #[tokio::test]
+    async fn idle_released_owner_gets_skip_then_exit_while_viewer_still_lags() {
+        let session = MainSession::inert();
+        let mut owner = session.subscribe();
+        let mut viewer = session.subscribe();
+        session.acquire_input_for_output(owner.id()).unwrap();
+        session.output.stop_backpressure();
+        for _ in 0..512 {
+            session
+                .output
+                .publish_paced(MainOutput::Stdout(Bytes::from(vec![0; 4096])))
+                .await;
+        }
+        session.complete_finish(5, false);
+        assert!(owner.recv().await.unwrap_err().skipped > 0);
+        assert!(owner.tail_idle_released());
+        loop {
+            if matches!(owner.recv().await.unwrap(), MainOutput::Exit(5)) {
+                break;
+            }
+        }
+        assert!(viewer.recv().await.is_err());
+        assert!(!viewer.tail_idle_released());
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn sandbox_and_supervisor_keep_a_fixed_descendant_tail_paced_until_exit() {
+        use openshell_sandbox::main_session::{
+            MainOutput as SandboxOutput, MainSession as SandboxMain,
+        };
+        use openshell_sandbox::process::ProcessIo;
+        let mut command = tokio::process::Command::new("sh");
+        command
+            .args([
+                "-c",
+                "printf 'main-last\\n'; (while :; do printf 'child-line\\n'; done) & exit 0",
+            ])
+            .stdin(std::process::Stdio::piped())
+            .stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::piped())
+            .kill_on_drop(true);
+        command.process_group(0);
+        let mut child = command.spawn().unwrap();
+        let pid =
+            rustix::process::Pid::from_raw(i32::try_from(child.id().unwrap()).unwrap()).unwrap();
+        let io = ProcessIo::Pipes {
+            stdin: child.stdin.take().unwrap(),
+            stdout: child.stdout.take().unwrap(),
+            stderr: child.stderr.take().unwrap(),
+        };
+        let sandbox = SandboxMain::new(io, child.id().unwrap(), None);
+        let mut sandbox_output = sandbox.subscribe();
+        let (supervisor, mut boundary) = paced_boundary();
+        let mut owner = supervisor.subscribe();
+        supervisor.acquire_input_for_output(owner.id()).unwrap();
+        let bridge = tokio::spawn(async move {
+            loop {
+                match sandbox_output.recv().await.unwrap() {
+                    SandboxOutput::Stdout(data) | SandboxOutput::Stderr(data) => {
+                        boundary.write_all(&data).await.unwrap();
+                    }
+                    SandboxOutput::Exit(0) => break,
+                    other @ SandboxOutput::Exit(_) => panic!("unexpected {other:?}"),
+                }
+            }
+        });
+        assert!(child.wait().await.unwrap().success());
+        let observed = tokio::time::Instant::now();
+        let sandbox_finish = tokio::spawn(async move { sandbox.finish(0, false).await });
+        let ending = supervisor.clone();
+        let supervisor_finish = tokio::spawn(async move { ending.finish_remote(0, false).await });
+        let mut output = Vec::new();
+        loop {
+            match owner.recv().await.expect("paced owner never lags") {
+                MainOutput::Stdout(data) => output.extend_from_slice(&data),
+                MainOutput::Exit(0) => break,
+                other => panic!("unexpected {other:?}"),
+            }
+            tokio::time::advance(std::time::Duration::from_millis(50)).await;
+            tokio::task::yield_now().await;
+        }
+        bridge.await.unwrap();
+        sandbox_finish.await.unwrap();
+        supervisor_finish.await.unwrap();
+        let _ = rustix::process::kill_process_group(pid, rustix::process::Signal::KILL);
+        assert!(output.starts_with(b"main-last\n"));
+        assert!(!owner.tail_idle_released());
+        println!(
+            "combined continuous-descendant tail: {} bytes, {:?} exit-to-event",
+            output.len(),
+            tokio::time::Instant::now() - observed
+        );
+    }
 }
