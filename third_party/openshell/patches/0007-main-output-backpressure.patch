+// Capture and delivery are independent. The timer snapshots the descriptor
+// under this same lock even while the reader is awaiting paced publication.
+struct MainTailState {
+    remaining: Option<usize>,
+    ended: bool,
+    held: usize,
+    #[cfg(test)]
+    snapshot: Option<(tokio::time::Instant, usize, usize)>,
+}
+
+struct MainTailCapture {
+    descriptor: Result<std::fs::File, rustix::io::Errno>,
+    state: Mutex<MainTailState>,
+    changed: watch::Sender<u64>,
+}
+
+impl MainTailCapture {
+    fn new(fd: impl AsFd) -> Arc<Self> {
+        Arc::new(Self {
+            descriptor: rustix::io::dup(fd).map(std::fs::File::from),
+            state: Mutex::new(MainTailState {
+                remaining: None,
+                ended: false,
+                held: 0,
+                #[cfg(test)]
+                snapshot: None,
+            }),
+            changed: watch::channel(0).0,
+        })
+    }
+
+    async fn freeze_at(self: Arc<Self>, deadline: tokio::time::Instant) {
+        tokio::time::sleep_until(deadline).await;
+        self.freeze();
+    }
+
+    fn freeze(&self) {
+        let mut state = self.state.lock().expect("main tail lock poisoned");
+        if state.ended || state.remaining.is_some() {
+            return;
+        }
+        let count = self
+            .descriptor
+            .as_ref()
+            .map_err(|error| *error)
+            .and_then(rustix::io::ioctl_fionread);
+        let count = match count {
+            Ok(count) => usize::try_from(count)
+                .unwrap_or(usize::MAX)
+                .min(OUTPUT_BUFFER_BYTES),
+            Err(error) => {
+                tracing::warn!(%error, "canonical main tail readable-count failed; ending capture");
+                0
+            }
+        };
+        state.remaining = Some(count);
+        #[cfg(test)]
+        {
+            state.snapshot = Some((tokio::time::Instant::now(), count, state.held));
+        }
+        drop(state);
+        self.changed
+            .send_modify(|version| *version = version.wrapping_add(1));
+    }
+
+    async fn read<R: AsyncRead + Unpin>(
+        &self,
+        reader: &mut R,
+        bytes: &mut [u8],
+    ) -> std::io::Result<usize> {
+        let mut changed = self.changed.subscribe();
+        loop {
+            let _ = changed.borrow_and_update();
+            let read = std::future::poll_fn(|cx| {
+                let mut state = self.state.lock().expect("main tail lock poisoned");
+                if state.ended || state.remaining == Some(0) {
+                    return Poll::Ready(Ok(0));
+                }
+                let limit = state.remaining.unwrap_or(bytes.len()).min(bytes.len());
+                let mut buffer = ReadBuf::new(&mut bytes[..limit]);
+                match Pin::new(&mut *reader).poll_read(cx, &mut buffer) {
+                    Poll::Pending => Poll::Pending,
+                    Poll::Ready(Err(error)) => {
+                        state.ended = true;
+                        Poll::Ready(Err(error))
+                    }
+                    Poll::Ready(Ok(())) => {
+                        let n = buffer.filled().len();
+                        if let Some(remaining) = &mut state.remaining {
+                            *remaining -= n;
+                        }
+                        state.held = n;
+                        state.ended |= n == 0;
+                        Poll::Ready(Ok(n))
+                    }
+                }
+            });
+            tokio::select! {
+                result = read => return result,
+                _ = changed.changed() => {}
+            }
+        }
+    }
+
+    fn published(&self) {
+        self.state.lock().expect("main tail lock poisoned").held = 0;
+    }
+}
