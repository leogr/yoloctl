+// Basic and indexed SGR spellings of the same palette entry are equivalent.
+func paletteIndex(c color.Color) (uint8, bool) {
+	switch c := c.(type) {
+	case ansi.BasicColor:
+		return uint8(c), true
+	case ansi.IndexedColor:
+		return uint8(c), true
+	default:
+		return 0, false
+	}
