+func parseSGRMouseSequence(seq []byte, start int) (int, Event) {
+	for i := start; i < len(seq); i++ {
+		c := seq[i]
+		if c >= '0' && c <= '9' || c == '-' || c == ';' {
+			continue
+		}
+		if c != 'M' && c != 'm' || i-start > 40 {
+			if c == ansi.ESC {
+				return i, UnknownCsiEvent(seq[:i])
+			}
+			return i + 1, UnknownCsiEvent(seq[:i+1])
+		}
+		fields := bytes.Split(seq[start:i], []byte{';'})
+		if len(fields) != 3 {
+			return i + 1, UnknownCsiEvent(seq[:i+1])
+		}
+		values := [3]int{0, 1, 1} // retain the defaults of the unsigned decoder
+		for j, field := range fields {
+			if len(field) == 0 {
+				continue
+			}
+			v, err := strconv.ParseInt(string(field), 10, 32)
+			if err != nil || v < -2147483647 || j == 0 && (v < 0 || v > 255) {
