+/// yoloctl: reset everything fullReset resets except the primary screen's
+/// rows and scrollback. The alternate screen is removed; the primary
+/// screen's transient state (cursor pen, hyperlink, pending wrap and
+/// protection, semantic content, saved cursor, charset, Kitty keyboard flags, protection mode,
+/// semantic prompt state, selection and Kitty graphics) is reset as
+/// Screen.reset does. The cursor moves to column 0 of the first row below the
+/// last row with text, scrolling one row if that is the bottom row, so later
+/// output never overwrites retained rows.
+pub fn resetKeepHistory(self: *Terminal) void {
+    // Ensure we're back on primary screen and drop the alternate screen.
+    self.screens.switchTo(.primary);
+    self.screens.remove(self.screens.active.alloc, .alternate);
+
+    // Reset our basic state, exactly as fullReset does.
+    self.flags = .{
+        .visible = self.flags.visible,
+        .resize_pull_scrollback = self.flags.resize_pull_scrollback,
+    };
+    self.modes.reset();
+    self.tabstops.reset(TABSTOP_INTERVAL);
+    self.previous_char = null;
+    self.pwd.clearRetainingCapacity();
+    self.title.clearRetainingCapacity();
+    self.glyph_glossary.clearAndFree(self.gpa());
+    if (self.kitty_dnd) |dnd| dnd.chunking = .{};
+    self.status_display = .main;
+    self.scrolling_region = .{
+        .top = 0,
+        .bottom = self.rows - 1,
+        .left = 0,
+        .right = self.cols - 1,
+    };
+    self.setCursorStyle(.default);
+    self.colors.palette.resetAll();
+
+    // Transient screen state, as Screen.reset resets it, keeping the rows.
+    const screen = self.screens.active;
+    screen.endHyperlink();
+    screen.cursor.hyperlink_implicit_id = 0;
+    screen.cursor.pending_wrap = false;
+    screen.cursor.protected = false;
+    screen.cursor.style = .{};
+    screen.manualStyleUpdate() catch {};
+    // New cells are output again, whatever OSC 133 state the last command left.
+    screen.cursorSetSemanticContent(.output);
+    if (comptime build_options.kitty_graphics) {
+        const image_limits = screen.kitty_images.image_limits;
+        const total_limit = screen.kitty_images.total_limit;
+        screen.kitty_images.deinit(screen.alloc, screen);
+        screen.kitty_images = .{
+            .dirty = true,
+            .image_limits = image_limits,
+            .total_limit = total_limit,
+        };
+    }
+    screen.saved_cursor = null;
+    screen.charset = .{};
+    screen.kitty_keyboard = .{};
+    screen.protected_mode = .off;
+    screen.semantic_prompt = .disabled;
+    screen.clearSelection();
+
+    // Continue on a fresh line below the last row with text.
+    var target: usize = 0;
+    var y: usize = self.rows;
+    while (y > 0) {
+        y -= 1;
+        const pin = screen.pages.pin(.{ .active = .{ .x = 0, .y = @intCast(y) } }) orelse continue;
+        if (Cell.hasTextAny(pin.cells(.all))) {
+            target = y + 1;
+            break;
+        }
+    }
+    if (target < self.rows) {
+        self.setCursorPos(target + 1, 1);
+    } else {
+        self.setCursorPos(self.rows, 1);
+        self.index() catch {};
+    }
+
+    // Always mark dirty so we redraw everything
+    self.flags.dirty.clear = true;
+}
