+/// yoloctl: like reset, but keeps the primary screen's rows and scrollback
+/// (Terminal.resetKeepHistory) and returns the stream to the state of a new
+/// one: fresh CSI/OSC parser and UTF-8 decoder, empty continuation, and no
+/// in-progress APC/DCS/clipboard transaction. Effects and limits are kept.
+pub fn resetKeepHistory(terminal_: Terminal) callconv(lib.calling_conv) void {
+    const wrapper = terminal_ orelse return;
+    const t: *ZigTerminal = wrapper.terminal;
+
+    // A reset always turns off synchronized output, ending its hold.
+    const sync = t.modes.get(.synchronized_output);
+    t.resetKeepHistory();
+
+    const stream = &wrapper.stream;
+    const osc_alloc = stream.parser.osc_parser.alloc;
+    const osc_max_allocating = stream.parser.osc_parser.max_allocating_bytes;
+    const osc_unknown_max = stream.parser.osc_parser.unknown_max_bytes;
+    stream.parser.deinit();
+    stream.parser = .init();
+    stream.parser.osc_parser.alloc = osc_alloc;
+    stream.parser.osc_parser.max_allocating_bytes = osc_max_allocating;
+    stream.parser.osc_parser.unknown_max_bytes = osc_unknown_max;
+    stream.utf8decoder = .{};
+    if (stream.continuation) |*tracker| tracker.reset();
+    stream.handler.resetTransient();
+
+    if (sync) Effects.renderHoldTrampoline(&wrapper.stream.handler, false);
+}
