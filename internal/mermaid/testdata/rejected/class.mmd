classDiagram
class Controller {
    +String space
    +Apply(box Box) error
    +Reconcile() error
}
class Box {
    +String name
    +String account
    +Start() error
    +Stop() error
}
class Account {
    +String name
    +Import(path string) error
}
class Session {
    +String id
    +Attach() error
}
Controller "1" --> "*" Box : manages
Box --> Account : uses
Box "1" *-- "*" Session : owns
Account <|-- AgentAccount
