[20.156847, "o", "\u001b[?25l\u001b]2;yoloctl\u0007\r\u001b[J\u001b[1;31H\u001b[38;5;243;48;5;235mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^D quit\u001b[m\r\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                              \u001b[m\r\n\n\u001b[38;5;243m  Type a yoloctl command and press Enter, for example:\u001b[m\r\n\u001b[38;5;243m    box create coder --agent claude\u001b[m\u001b[K\r\n\u001b[38;5;243m    box attach coder\u001b[m\u001b[K\r\n\u001b[38;5;243m    space ls\u001b[m\u001b[1;11H\u001b[?25h"]
