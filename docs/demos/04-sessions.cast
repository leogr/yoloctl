[24.045305, "o", "\u001b[?25l\u001b]2;yoloctl — ✳ leogr\\coordinator: Claude Code\u0007\u001b[2;5H\u001b[38;2;217;119;87;1m✳\u001b[38;5;215m  leogr\\coordinator: Claude Code ✕ \u001b[m\r\n\n\u001b[38;5;174m ▐\u001b[48;5;16m▛███▛█\u001b[m   \u001b[1mClaude Code\u001b[m \u001b[38;5;246mv2.1.318\u001b[m\r\n\u001b[38;5;174m▝▜\u001b[48;5;16m█████\u001b[49m█▀\u001b[m  \u001b[38;5;246mOpus 5.5 · Claude Ultra\u001b[m\r\n\u001b[38;5;174m ▝▝   ▝▝ \u001b[m  \u001b[38;5;246m/workdir\u001b[m\r\n\n  Get to finished work sooner with Opus 5.5. Switch anytime with \u001b[38;5;153m/model\u001b[m.\r\n  \u001b[38;5;246m1 more notice hidden\u001b[m\r\u001b[28d\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n❯ review the open pull requests and summarize the risks\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\n  \u001b[38;5;211m⏵⏵ bypass permissions on\u001b[38;5;246m · \u001b[38;5;44m1 monitor\u001b[m\u001b[29;56H\u001b[?25h"]
