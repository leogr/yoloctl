b]4;176;?\u001b\\\u001b]4;177;?\u001b\\\u001b]4;178;?\u001b\\\u001b]4;179;?\u001b\\\u001b]4;180;?\u001b\\\u001b]4;181;?\u001b\\\u001b]4;182;?\u001b\\\u001b]4;183;?\u001b\\\u001b]4;184;?\u001b\\\u001b]4;185;?\u001b\\\u001b]4;186;?\u001b\\\u001b]4;187;?\u001b\\\u001b]4;188;?\u001b\\\u001b]4;189;?\u001b\\\u001b]4;190;?\u001b\\\u001b]4;191;?\u001b\\\u001b]4;192;?\u001b\\\u001b]4;193;?\u001b\\\u001b]4;194;?\u001b\\\u001b]4;195;?\u001b\\\u001b]4;196;?\u001b\\\u001b]4;197;?\u001b\\\u001b]4;198;?\u001b\\\u001b]4;199;?\u001b\\\u001b]4;200;?\u001b\\\u001b]4;201;?\u001b\\\u001b]4;202;?\u001b\\\u001b]4;203;?\u001b\\\u001b]4;204;?\u001b\\\u001b]4;205;?\u001b\\\u001b]4;206;?\u001b\\\u001b]4;207;?\u001b\\\u001b]4;208;?\u001b\\\u001b]4;209;?\u001b\\\u001b]4;210;?\u001b\\\u001b]4;211;?\u001b\\\u001b]4;212;?\u001b\\\u001b]4;213;?\u001b\\\u001b]4;214;?\u001b\\\u001b]4;215;?\u001b\\\u001b]4;216;?\u001b\\\u001b]4;217;?\u001b\\\u001b]4;218;?\u001b\\\u001b]4;219;?\u001b\\\u001b]4;220;?\u001b\\\u001b]4;221;?\u001b\\\u001b]4;222;?\u001b\\\u001b]4;223;?\u001b\\\u001b]4;224;?\u001b\\\u001b]4;225;?\u001b\\\u001b]4;226;?\u001b\\\u001b]4;227;?\u001b\\\u001b]4;228;?\u001b\\\u001b]4;229;?\u001b\\\u001b]4;230;?\u001b\\\u001b]4;231;?\u001b\\\u001b]4;232;?\u001b\\\u001b]4;233;?\u001b\\\u001b]4;234;?\u001b\\\u001b]4;235;?\u001b\\\u001b]4;236;?\u001b\\\u001b]4;237;?\u001b\\\u001b]4;238;?\u001b\\\u001b]4;239;?\u001b\\\u001b]4;240;?\u001b\\\u001b]4;241;?\u001b\\\u001b]4;242;?\u001b\\\u001b]4;243;?\u001b\\\u001b]4;244;?\u001b\\\u001b]4;245;?\u001b\\\u001b]4;246;?\u001b\\\u001b]4;247;?\u001b\\\u001b]4;248;?\u001b\\\u001b]4;249;?\u001b\\\u001b]4;250;?\u001b\\\u001b]4;251;?\u001b\\\u001b]4;252;?\u001b\\\u001b]4;253;?\u001b\\\u001b]4;254;?\u001b\\\u001b]4;255;?\u001b\\\u001b[>4m\u001b[?1049h\u001b[?5W\u001b[?2004h\u001b[?1004h\u001b]2;yoloctl\u0007\u001b[>4;2m\u001b[>31u\u001b[?u\u001b[1 q\u001b[H\u001b[2J\u001b[38;5;215;48;5;235m❯ \u001b[1myoloctl\u001b[39;22m\u001b[48X\u001b[1;58H\u001b[38;5;243mEsc hide palette · ^Q panes · ^←/→ tabs · ^D quit · \u001b[38;5;67;1m(showcase)\u001b[39;22m\u001b[K\u001b[m\r\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\n\u001b[38;5;243m  type a yoloctl command and press Enter\u001b[m\r\n\u001b[38;5;243m  e.g.: box create coder --agent claude · box attach coder · space ls\u001b[m\u001b[1;11H\u001b[?25h\u001b[?25l\u001b[48;5;235mb \u001b[m\b\u001b[?25h\u001b[?25l\r\n\u001b[2L\u001b[1;12H\u001b[38;5;243;48;5;235mox\u001b[39m \u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ box\u001b[39;22m  \u001b[38;5;243mManage boxes (sandboxed containers, 1:1 with a coding agent)\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\u001b[1;12H\u001b[?25h\u001b[?25l\u001b[48;5;235mo\u001b[38;5;243mx\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mx \u001b[m\b\u001b[?25h\u001b[?25l\u001b[C\u001b[?25h\u001b[?25l\n\u001b[3G\u001b[38;5;215;48;5;235;1mattach   \u001b[39;22m  \u001b[38;5;243mAttach to the box's persistent terminal session\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  copy     \u001b[39m  \u001b[38;5;243mCreate a new box from an existing box's manifest (settings only)\u001b[m\r\n\u001b[38;5;67;48;5;235m  create   \u001b[39m  \u001b[38;5;243mCreate a confined box inside a space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  destroy  \u001b[39m  \u001b[38;5;243mStop and remove a box (runtime + its declaration)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  diff     \u001b[39m  \u001b[38;5;243mShow the reconcile plan without applying it (like `reconcile --dry-run`)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  edit     \u001b[39m  \u001b[38;5;243mEdit the box YAML in $EDITOR; reconcile on save\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  exec     \u001b[39m  \u001b[38;5;243mRun a command inside a box via the sandbox SSH socket (kubectl-exec mapping)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  inspect  \u001b[39m  \u001b[38;5;243mRead-only debug view: resolved inputs, computed policy, and reconstructed runtime\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  list     \u001b[39m  \u001b[38;5;243mList declared boxes and their runtime state\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  logs     \u001b[39m  \u001b[38;5;243mStream a box's stdout/stderr\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  reconcile\u001b[39m  \u001b[38;5;243mReconcile a box runtime with its manifest\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  recreate \u001b[39m  \u001b[38;5;243mTear down and rebuild a box container from its persisted YAML\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  restart  \u001b[39m  \u001b[38;5;243mRestart a box (stop its runtime, then start it again)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  session  \u001b[39m  \u001b[38;5;243mShow a box's agent conversation record (read-only)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  set      \u001b[39m  \u001b[38;5;243mMutate scalar box fields and reconcile\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  show     \u001b[39m  \u001b[38;5;243mPrint a box's declaration, runtime, session, and drift state\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  start    \u001b[39m  \u001b[38;5;243mStart or materialize a box from its declaration\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  stop     \u001b[39m  \u001b[38;5;243mGracefully stop a box (lets openshell-sandbox tear down its netns)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  use      \u001b[39m  \u001b[38;5;243mObserve or steer a persistent session, then detach (JSON Lines)\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\n\u001b[38;5;243m  type a yoloctl command and press Enter\u001b[m\r\n\u001b[38;5;243m  e.g.: box create coder --agent claude · box attach coder · space ls\u001b[m\u001b[1;15H\u001b[?25h\u001b[?25l\u001b[48;5;235mc \u001b[m\b\u001b[?25h\u001b[?25l\r\u001b[9d\u001b[J\u001b[1;16H\u001b[38;5;243;48;5;235mopy\u001b[39m \u001b[m\n\u001b[3G\u001b[38;5;215;48;5;235;1mcopy  \u001b[39;22m  \u001b[38;5;243mCreate a new box from an existing box's manifest (settings only)\u001b[m\n\u001b[4G\u001b[38;5;67;48;5;235mreate\u001b[39m  \u001b[38;5;243mCreate a confined box inside a space\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\u001b[K\n\u001b[38;5;243m  type a yoloctl command and press Enter\u001b[m\u001b[K\r\n\u001b[38;5;243m  e.g.: box create coder --agent claude · box attach coder · space ls\u001b[m\u001b[K\u001b[1;16H\u001b[?25h\u001b[?25l\u001b[48;5;235mr   \u001b[m\b\b\b\u001b[?25h\u001b[?25l\r\n\u001b[M\u001b[1;17H\u001b[38;5;243;48;5;235meate\u001b[39m \u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ create\u001b[m\u001b[1;17H\u001b[?25h\u001b[?25l\u001b[48;5;235me\u001b[38;5;243ma\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235ma\u001b[38;5;243mt\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mt\u001b[38;5;243me\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235me \u001b[m\b\u001b[?25h\u001b[?25l\u001b[C\u001b[?25h\u001b[?25l\u001b[48;5;235mr \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235me \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mv \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mi \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235me \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mw \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235me \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mr \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235m- \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mr \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mo \u001b[m\b\u001b[?25h\u001b[?25l\u001b[C\u001b[?25h\u001b[?25l\u001b[48;5;235m- \u001b[m\b\u001b[?25h\u001b[?25l\u001b[38;5;243;48;5;235m-account\u001b[m\n\u001b[3G\u001b[38;5;215;48;5;235;1m--account\u001b[13X\u001b[2;25H\u001b[39;22m  \u001b[38;5;243mAccount this box selects (a plain name, e.g. default or personal). Defaults to the space's in…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --agent\u001b[15X\u001b[3;25H\u001b[39m  \u001b[38;5;243mAgent this box will host ([agy claude codex gemini opencode pi]). Pre-fills --image (the agen…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --agent-extra-args    \u001b[39m  \u001b[38;5;243mExtra args appended after the agent definition's default_args when yoloctl starts a managed a…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --agent-session-resume\u001b[39m  \u001b[38;5;243mConversation policy for agents that declare one (Claude): last resumes the box's own conversa…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --capability          \u001b[39m  \u001b[38;5;243mExplicit positive capability to grant (repeatable), e.g. network.github, or fs.pty.allocate t…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --cpus\u001b[16X\u001b[7;25H\u001b[39m  \u001b[38;5;243mCPU time cap in CPUs, e.g. 2 or 0.5 (omit to share all VM CPUs without a box cap)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --drop-capability     \u001b[39m  \u001b[38;5;243mDrop a capability from the box's default+explicit set (repeatable), e.g. fs.workdir.write. Ca…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --env\u001b[17X\u001b[9;25H\u001b[39m  \u001b[38;5;243mSet a literal environment variable KEY=VALUE in the box (repeatable). Non-secret by conventio…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --feature\u001b[13X\u001b[10;25H\u001b[39m  \u001b[38;5;243mFeature name or OCI reference (repeatable)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --feature-option      \u001b[39m  \u001b[38;5;243mOCI Feature option: FEATURE.OPTION=VALUE (repeatable; non-secret)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5