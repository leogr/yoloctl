[15.528237, "o", "\u001b[?25l\r\n\u001b[L\u001b[1;3H\u001b[38;5;215;48;5;235;1myoloctl\u001b[39;22m\u001b[23X\u001b[1;33H\u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^D quit\u001b[m\r\u001b[8d\u001b[38;5;2;48;5;235m✓\u001b[39m \u001b[2mhost▸\u001b[38;5;5;22myoloctl\u001b[39m        \u001b[38;5;2mCreating space yolo-team\u001b[39m  \u001b[2m16.3s\u001b[m\u001b[11;3H\u001b[38;5;2;48;5;235m✓\u001b[39m \u001b[38;5;2mStarting controller\u001b[39m  \u001b[2m16.3s\u001b[m\r\u001b[5B\u001b[38;5;2;48;5;235m✓\u001b[39m \u001b[38;5;2mexit 0\u001b[39m\u001b[K\u001b[m\u001b[1;11H\u001b[?25h"]
