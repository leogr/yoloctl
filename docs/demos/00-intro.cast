[24.71286, "o", "\u001b[?25l\r\u001b[32d\u001b[14S\u001b[H\u001b[38;5;215;48;5;235m❯ \u001b[1myoloctl\u001b[39;22m b\u001b[38;5;243mox\u001b[39m\u001b[17X\u001b[1;31H\u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^D quit · \u001b[38;5;67;1myolo-team ▾\u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ box\u001b[39;22m  \u001b[38;5;243mManage boxes for coding agents, shells and other workloads\u001b[m\u001b[1;12H\u001b[?25h"]
[24.762479, "o", "\u001b[?25l\u001b[48;5;235mo\u001b[38;5;243mx\u001b[m\b\u001b[?25h"]
