m \u001b[m\u001b[4D\u001b[?25h\u001b[?25l\u001b[48;5;235mo   \u001b[m\b\b\b\u001b[?25h\u001b[?25l\u001b[48;5;235mo \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mr \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235md \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mi \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mn \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235ma \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mt \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mo \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mr \u001b[m\b\u001b[?25h\u001b[?25l\r\n\u001b[3M\u001b[38;5;215;48;5;235;1m▸ coordinator\u001b[m\u001b[1;29H\u001b[?25h\u001b[?25l\u001b]2;yoloctl — attach coordinator\u0007\r\n\n\u001b[J\u001b[1;11H\u001b[48;5;235m\u001b[75X\u001b[1;86H\u001b[38;5;243m^Y palette · ^Q panes\u001b[m\r\n\u001b[38;5;67;48;5;235;4m \u001b[38;5;215;49;24;1m ❶ attach coordinator ✕ \u001b[38;5;67;48;5;235;22;4m                                                                                               \u001b[m\r\n\u001b[?25h\u001b[?9l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1003h\u001b[?25l\u001b]2;yoloctl — ✳ leogr\\coordinator: Claude Code\u0007\u001b[2;5H\u001b[38;2;217;119;87;1m✳\u001b[38;5;215m  leogr\\coordinator: Claude Code ✕ \u001b[m\r\n\n\u001b[38;5;174m ▐\u001b[48;5;16m▛███▛█\u001b[m   \u001b[1mClaude Code\u001b[m \u001b[38;5;246mv2.1.318\u001b[m\r\n\u001b[38;5;174m▝▜\u001b[48;5;16m█████\u001b[49m█▀\u001b[m  \u001b[38;5;246mOpus 5.5 · Claude Ultra\u001b[m\r\n\u001b[38;5;174m ▝▝   ▝▝ \u001b[m  \u001b[38;5;246m/workdir\u001b[m\r\u001b[28d\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n❯ \u001b[2mTry \"edit <filepath> to...\"\u001b[m\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n\n  \u001b[38;5;211m⏵⏵ bypass permissions on\u001b[38;5;246m · \u001b[38;5;44m1 monitor\u001b[m\u001b[29;3H\u001b[?25h\u001b[?9l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1002h\u001b[?25l\u001b[1;58H\u001b[38;5;243;48;5;235mEsc hide palette · ^Q panes · ^←/→ tabs · ^D quit\u001b[m\u001b[1;11H\u001b[?25h\u001b[?25l\r\n\u001b[4L\u001b[1;11H\u001b[48;5;235ma\u001b[38;5;243mccount\u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ account\u001b[39;22m  \u001b[38;5;243mManage accounts (identity keychains: provider secrets + per-agent state)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  agent  \u001b[39m  \u001b[38;5;243mManage agents (catalog) and agent CLI tooling (Antigravity, Claude Code, Codex, Gemini, OpenCode, Pi)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  attach \u001b[39m  \u001b[38;5;243mAttach to the box's persistent terminal session\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\u001b[1;12H\u001b[?25h\u001b[?25l\u001b[48;5;235mt     \u001b[m\u001b[5D\u001b[?25h\u001b[?25l\r\n\u001b[2M\u001b[1;13H\u001b[38;5;243;48;5;235mtach\u001b[39m \u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ attach\u001b[39;22m \u001b[P\u001b[m\r\u001b[31d❯ \u001b[2mTry \"edit <filepath> to...\"\u001b[m\r\n\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[?7l─\u001b[?7h\u001b[m\u001b[1;13H\u001b[?25h\u001b[?25l\u001b[48;5;235mt\u001b[38;5;243ma\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235ma\u001b[38;5;243mc\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mc\u001b[38;5;243mh\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mh \u001b[m\b\u001b[?25h\u001b[?25l\u001b[C\u001b[?25h\u001b[?25l\r\n\n\u001b[3L\u001b[2;3H\u001b[38;5;215;48;5;235;1mchat       \u001b[39;22m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  coordinator\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  dev        \u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  reviewer   \u001b[39m\u001b[K\u001b[m\u001b[1;18H\u001b[?25h\u001b[?25l\u001b[48;5;235md \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;