[6.962813, "o", "\u001b7\u001b[?6l\u001b[32;1H\u001b[0;39;49m  \u001b[0;38;2;255;135;175;49m⏵⏵ bypass permissions on\u001b[0;38;2;148;148;148;49m · \u001b[0;38;2;0;215;215;49m1 monitor\u001b[0;39;49m                                                                                  \u001b[0m\u001b8\u001b[?25l\u001b[0 q\u001b[4d\b\u001b[38;5;243;48;5;235m╭─\u001b[38;5;215;1m panes \u001b[38;5;243;22m───────────────────────────╮\u001b[m\n\u001b[2G\u001b[38;5;243;48;5;235m│\u001b[39m Split right\u001b[21X\u001b[5;36H| \u001b[38;5;243m│\u001b[m\n\u001b[2G\u001b[38;5;243;48;5;235m│\u001b[39m Split below\u001b[21X\u001b[6;36H- \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mZoom\u001b[28X\u001b[7;36Hz\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mSpread evenly\u001b[19X\u001b[8;36H=\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mSwap with previous\u001b[14X\u001b[9;36H{\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mSwap with next\u001b[18X\u001b[10;36H}\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m Break out\u001b[23X\u001b[11;36H! \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m Bring a tab in\u001b[18X\u001b[12;36Hj \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m Detach pane\u001b[21X\u001b[13;36Hx \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243m─────────────────────────────────\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mFocus\u001b[24X\u001b[15;33H←↑↓→\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m Focus next\u001b[22X\u001b[16;36Ho \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mResize border  ^arrows Alt+arrows\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243m─────────────────────────────────\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m New tab\u001b[25X\u001b[19;36Hc \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m Next tab\u001b[24X\u001b[20;36Hn \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m Previous tab\u001b[20X\u001b[21;36Hp \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m Pick a tab\u001b[22X\u001b[22;36Hw \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mTab by number\u001b[15X\u001b[23;32H1…9 0\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m Detach whole tab\u001b[16X\u001b[24;36Hd \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243m─────────────────────────────────\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mSend ^Q\u001b[24X\u001b[26;35H^Q\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m\u001b[35X\u001b[27;38H\u001b[38;5;243m│\u001b[m\n\u001b[2G\u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;215;1mpress a key or click · Esc closes\u001b[39;22m \u001b[38;5;243m│\u001b[m\n\u001b[2G\u001b[38;5;243;48;5;235m╰───────────────────────────────────╯\u001b[m\u001b7\u001b[?6l\u001b[32;1H\u001b[0;1;97;48;5;24m one palette, every agent in its own tab                                                                                \u001b[0m\u001b8"]
