8;5;110;1m@\u001b[38;5;243;22m mention\u001b[38;5;238m · \u001b[38;5;110;1m/help\u001b[38;5;243;22m keys\u001b[m\u001b[17;61H\u001b[38;5;67m│\u001b[38;5;232;48;5;67m  yoloctl — chat\u001b[35X\u001b[35C\u001b[38;5;255;48;5;60m ⤢ \u001b[38;5;232;48;5;67m \u001b[38;5;255;48;5;60m ✕ \u001b[38;5;232;48;5;67m\u001b[K\u001b[m\u001b[18;62H\u001b[K\n\u001b[38;5;243m    what goes here?\u001b[m\u001b[K\u001b[20;62H\u001b[38;5;243m    type a yoloctl command ↵\u001b[m\u001b[21;62H\u001b[38;5;243m    ^Q j N brings tab N here\u001b[m\u001b[22;62H\u001b[38;5;243m    an attach from this tab's\u001b[m\u001b[K\u001b[23;62H\u001b[38;5;243m      space view or chat opens here\u001b[m\u001b[K\u001b[24;62H\u001b[38;5;243m    Esc removes it\u001b[m\u001b[K\u001b[25;66H\u001b[K\n\u001b[K\n\u001b[4D\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\t\u001b[38;5;235;48;5;215;1mempty \u001b[22m\u001b[45X\u001b[m\u001b[1;11H\u001b[?25h\u001b[?25l\u001b[7;13r\u001b[7;1H\u001bM\u001b[1;32r\u001b[3;62H\u001b[38;5;174;48;2;0;0;0;1m ◈ \u001b[38;5;255mshowcase\u001b[39;22m \u001b[38;5;174;1m#space\u001b[38;5;243;22m  4 online\u001b[39m\u001b[24X\t\t\t \u001b[38;5;108;1m◉ LIVE\u001b[39;22m\u001b[K\u001b[m\u001b[4;66H\u001b[38;5;252mdev qualify the opening and link the privileged-box \u001b[m\u001b[5;62H\u001b[38;5;223m▌\u001b[m   \u001b[38;5;252mexception if \u001b[38;5;230;48;5;94;1m@leogr\u001b[38;5;252;49;22m wants it.\u001b[m\u001b[6;63H\u001b[K\n\b\b\u001b[38;5;67m│\u001b[m \u001b[38;2;217;119;87;1m✳  dev\u001b[38;5;243;22m  15:05\u001b[m\u001b[1;11H\u001b[?25h\u001b[?25l\u001b[48;5;235ms \u001b[m\b\u001b[?25h\u001b[?25l\r\n\u001b[2L\u001b[1;12H\u001b[38;5;243;48;5;235mpace\u001b[39m \u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ space\u001b[39;22m  \u001b[38;5;243mManage yoloctl spaces (the VM isolation boundary)\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\u001b[1;12H\u001b[?25h\u001b[?25l\u001b[48;5;235mp\u001b[38;5;243ma\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235ma\u001b[38;5;243mc\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mc\u001b[38;5;243me\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235me \u001b[m\b\u001b[?25h\u001b[?25l\u001b[C\u001b[?25h\u001b[?25l\n\u001b[3G\u001b[38;5;215;48;5;235;1mcreate   \u001b[39;22m  \u001b[38;5;243mCreate a space with a required workdir and initial account\u001b[m\r\n\u001b[38;5;67;48;5;235m  destroy  \u001b[39m  \u001b[38;5;243mDelete a space, its accounts and declarations\u001b[m\r\n\u001b[38;5;67;48;5;235m  edit     \u001b[39m  \u001b[38;5;243mEdit a stopped space's CPU, memory and system disk allocation in $EDITOR\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  export   \u001b[39m  \u001b[38;5;243mBack up declarations and native account state\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  import   \u001b[39m  \u001b[38;5;243mRestore a backup into a new space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  list     \u001b[39m  \u001b[38;5;243mList yoloctl spaces\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  logs     \u001b[39m  \u001b[38;5;243mStream the VM boot/runtime log for a space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  mount    \u001b[39m  \u001b[38;5;243mManage a space's host→VM mount grants\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  operation\u001b[39m  \u001b[38;5;243mInspect recorded controller mutation outcomes\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  recreate \u001b[39m  \u001b[38;5;243mReplace and start the VM, preserving accounts and declarations\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  set      \u001b[39m  \u001b[38;5;243mChange a stopped space's CPU, memory and system disk allocation\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  show     \u001b[39m  \u001b[38;5;243mShow one space's VM config, workdirs, and box inventory\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  ssh      \u001b[39m  \u001b[38;5;243mOpen a shell in a space's VM (VM-level access, outside the OpenShell sandbox)\u001b[3