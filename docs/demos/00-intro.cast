[18.235808, "o", "\u001b[?25l\u001b[0 q\u001b[2;77H\u001b[38;5;243;48;5;235m╭─\u001b[38;5;215;1m Switch space \u001b[38;5;243;22m───────────────────────────╮\u001b[m\r\u001b[3;77H\u001b[38;5;243;48;5;235m│\u001b[39m \u001b[7myolo-team                               \u001b[27m \u001b[38;5;243m│\u001b[m\r\u001b[4;77H\u001b[38;5;243;48;5;235m│\u001b[39m\u001b[42X\u001b[42C\u001b[38;5;243m│\u001b[m\r\u001b[5;77H\u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mSwitches only this TUI\u001b[39m\u001b[19X\t\t\t\t\u001b[38;5;243m│\u001b[m\r\u001b[6;77H\u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;215myoloctl space use\u001b[38;5;243m changes the default\u001b[39m    \u001b[38;5;243m│\u001b[m\r\u001b[7;77H\u001b[38;5;243;48;5;235m╰──────────────────────────────────────────╯\u001b[m"]
