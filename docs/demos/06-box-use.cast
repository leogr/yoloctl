]4;176;?\u001b\\\u001b]4;177;?\u001b\\\u001b]4;178;?\u001b\\\u001b]4;179;?\u001b\\\u001b]4;180;?\u001b\\\u001b]4;181;?\u001b\\\u001b]4;182;?\u001b\\\u001b]4;183;?\u001b\\\u001b]4;184;?\u001b\\\u001b]4;185;?\u001b\\\u001b]4;186;?\u001b\\\u001b]4;187;?\u001b\\\u001b]4;188;?\u001b\\\u001b]4;189;?\u001b\\\u001b]4;190;?\u001b\\\u001b]4;191;?\u001b\\\u001b]4;192;?\u001b\\\u001b]4;193;?\u001b\\\u001b]4;194;?\u001b\\\u001b]4;195;?\u001b\\\u001b]4;196;?\u001b\\\u001b]4;197;?\u001b\\\u001b]4;198;?\u001b\\\u001b]4;199;?\u001b\\\u001b]4;200;?\u001b\\\u001b]4;201;?\u001b\\\u001b]4;202;?\u001b\\\u001b]4;203;?\u001b\\\u001b]4;204;?\u001b\\\u001b]4;205;?\u001b\\\u001b]4;206;?\u001b\\\u001b]4;207;?\u001b\\\u001b]4;208;?\u001b\\\u001b]4;209;?\u001b\\\u001b]4;210;?\u001b\\\u001b]4;211;?\u001b\\\u001b]4;212;?\u001b\\\u001b]4;213;?\u001b\\\u001b]4;214;?\u001b\\\u001b]4;215;?\u001b\\\u001b]4;216;?\u001b\\\u001b]4;217;?\u001b\\\u001b]4;218;?\u001b\\\u001b]4;219;?\u001b\\\u001b]4;220;?\u001b\\\u001b]4;221;?\u001b\\\u001b]4;222;?\u001b\\\u001b]4;223;?\u001b\\\u001b]4;224;?\u001b\\\u001b]4;225;?\u001b\\\u001b]4;226;?\u001b\\\u001b]4;227;?\u001b\\\u001b]4;228;?\u001b\\\u001b]4;229;?\u001b\\\u001b]4;230;?\u001b\\\u001b]4;231;?\u001b\\\u001b]4;232;?\u001b\\\u001b]4;233;?\u001b\\\u001b]4;234;?\u001b\\\u001b]4;235;?\u001b\\\u001b]4;236;?\u001b\\\u001b]4;237;?\u001b\\\u001b]4;238;?\u001b\\\u001b]4;239;?\u001b\\\u001b]4;240;?\u001b\\\u001b]4;241;?\u001b\\\u001b]4;242;?\u001b\\\u001b]4;243;?\u001b\\\u001b]4;244;?\u001b\\\u001b]4;245;?\u001b\\\u001b]4;246;?\u001b\\\u001b]4;247;?\u001b\\\u001b]4;248;?\u001b\\\u001b]4;249;?\u001b\\\u001b]4;250;?\u001b\\\u001b]4;251;?\u001b\\\u001b]4;252;?\u001b\\\u001b]4;253;?\u001b\\\u001b]4;254;?\u001b\\\u001b]4;255;?\u001b\\\u001b[>4m\u001b[?1049h\u001b[?5W\u001b[?2004h\u001b[?1004h\u001b]2;yoloctl\u0007\u001b[>4;2m\u001b[>31u\u001b[?u\u001b[1 q\u001b[H\u001b[2J\u001b[38;5;215;48;5;235m❯ \u001b[1myoloctl\u001b[39;22m\u001b[23X\u001b[1;33H\u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^D quit · \u001b[38;5;67;1mdefault ▾\u001b[39;22m\u001b[K\u001b[m\r\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\n\u001b[38;5;243m  Tip: you have no space yet. A space is the VM your boxes run in. To create one, type:\u001b[m\r\n\u001b[38;5;243m    \u001b[4mspace create work --workdir /var/tmp/demo040/project --account sandbox\u001b[m\r\n\u001b[38;5;243m    (change the name and account first)\u001b[m\r\n\u001b[38;5;243m  Click the command to put it in the input.\u001b[m\u001b[1;11H\u001b[?25h\u001b[?25l\u001b[48;5;235ms \u001b[m\u001b[5;5H\u001b[38;5;243mspace create work --workdir /var/tmp/demo040/project --account sandbox\u001b[m\u001b[1;12H\u001b[?25h\u001b[?25l\r\n\u001b[2L\u001b[1;12H\u001b[38;5;243;48;5;235mpace\u001b[39m \u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ space\u001b[39;22m  \u001b[38;5;243mManage yoloctl spaces (the VM isolation boundary)\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\u001b[1;12H\u001b[?25h\u001b[?25l\u001b[48;5;235mp\u001b[38;5;243ma\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235ma\u001b[38;5;243mc\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mc\u001b[38;5;243me\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235me \u001b[m\b\u001b[?25h\u001b[?25l\u001b[C\u001b[?25h\u001b[?25l\n\u001b[3G\u001b[38;5;215;48;5;235;1mcreate   \u001b[39;22m  \u001b[38;5;243mCreate a space with a required workdir and initial account\u001b[m\r\n\u001b[38;5;67;48;5;235m  destroy  \u001b[39m  \u001b[38;5;243mDelete a space, its accounts and declarations\u001b[m\r\n\u001b[38;5;67;48;5;235m  edit     \u001b[39m  \u001b[38;5;243mEdit a stopped space's CPU, memory and system disk allocation in $EDITOR\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  export   \u001b[39m  \u001b[38;5;243mBack up declarations and native account state\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  import   \u001b[39m  \u001b[38;5;243mRestore a backup into a new space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  list     \u001b[39m  \u001b[38;5;243mList yoloctl spaces\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  logs     \u001b[39m  \u001b[38;5;243mStream the VM boot/runtime log for a space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  mount    \u001b[39m  \u001b[38;5;243mManage a space's host→VM mount grants\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  operation\u001b[39m  \u001b[38;5;243mInspect recorded controller mutation outcomes\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  recreate \u001b[39m  \u001b[38;5;243mReplace and start the VM, preserving accounts and declarations\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  set      \u001b[39m  \u001b[38;5;243mChange a stopped space's VM settings\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  show     \u001b[39m  \u001b[38;5;243mShow one space's VM config, workdirs, and box inventory\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  ssh      \u001b[39m  \u001b[38;5;243mOpen a shell in a space's VM (VM-level access, outside the OpenShell sandbox)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  start    \u001b[39m  \u001b[38;5;243mStart a yoloctl space (recreating the VM from its bundle if needed)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  stop     \u001b[39m  \u001b[38;5;243mStop a yoloctl space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  storage  \u001b[39m  \u001b[38;5;243mShow what fills the VM's system and data disks\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  upgrade  \u001b[39m  \u001b[38;5;243mUpdate a space to this build and review box changes\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  use      \u001b[39m  \u001b[38;5;243mShow or switch the current-context space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  view     \u001b[39m  \u001b[38;5;243mShow a live, clickable view of a space's boxes and resources\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\n\u001b[38;5;243m  Tip: you have no space yet. A space is the VM your boxes run in. To create one, type:\u001b[m\r\n\u001b[38;5;243m    space create work --workdir /var/tmp/demo040/project --account sandbox\u001b[m\r\n\u001b[38;5;243m    (change the name and account first)\u001b[m\r\n\u001b[38;5;243m  Click the command to put it in the input.\u001b[m\u001b[1;17H\u001b[?25h\u001b[?25l\r\u001b[9B\u001b[J\u001b[1;17H\u001b[48;5;235mc\u001b[38;5;243mreate\u001b[m\u001b[2;9H\u001b[48;5;235m \u001b[3P\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\u001b[K\n\u001b[38;5;243m  Tip: you have no space yet. A space is the VM your boxes run in. To create one, type:\u001b[m\u001b[K\r\n\u001b[38;5;243m    space create work --workdir /var/tmp/demo040/project --account sandbox\u001b[m\u001b[K\r\n\u001b[38;5;243m    (change the name and account first)\u001b[m\u001b[K\r\n\u001b[38;5;243m  Click the command to put it in the input.\u001b[m\u001b[K\u001b[1;18H\u001b[?25h\u001b[?25l\u001b[48;5;235mr\u001b[38;5;243me\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235me\u001b[38;5;243ma\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235ma\u001b[38;5;243mt\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mt\u001b[38;5;243me\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235me \u001b[m\b\u001b[?25h\u001b[?25l\u001b[C\u001b[?25h\u001b[?25l\r\n\n\u001b[L\u001b[2;3H\u001b[38;5;215;48;5;235;1m--account\u001b[39;22m  \u001b[38;5;243mRequired initial account name (also the space default)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --workdir\u001b[3