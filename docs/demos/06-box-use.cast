235mroject/\u001b[39m \u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R his\u001b[m\u001b[2;20H\u001b[38;5;215;48;5;235;1mproject/\u001b[m\u001b[1;62H\u001b[?25h\u001b[?25l\u001b[48;5;235mr\u001b[38;5;243mo\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mo\u001b[38;5;243mj\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mj\u001b[38;5;243me\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235me\u001b[38;5;243mc\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mc\u001b[38;5;243mt\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mt\u001b[38;5;243m/\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235m  \u001b[m\b\u001b[?25h\u001b[?25l\n\u001b[3G\u001b[38;5;215;48;5;235;1m--account\u001b[39;22m  \u001b[38;5;243mRequired initial account name (also the space default)\u001b[m\u001b[A\u001b[C\u001b[?25h\u001b[?25l\u001b[48;5;235m-\u001b[38;5;243m-account\u001b[39m \u001b[38;5;243mEsc hide palette · ^←/→ tab\u001b[m\u001b[1;70H\u001b[?25h\u001b[?25l\u001b[48;5;235m-\u001b[38;5;243ma\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235ma\u001b[38;5;243mc\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mc\u001b[38;5;243mc\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mc\u001b[38;5;243mo\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mo\u001b[38;5;243mu\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mu\u001b[38;5;243mn\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mn\u001b[38;5;243mt\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mt \u001b[m\b\u001b[?25h\u001b[?25l\u001b[C\u001b[48;5;235m \u001b[38;5;243mEsc hide palette · ^←/→ tab\u001b[m\u001b[1;79H\u001b[?25h\u001b[?25l\r\u001b[32d\u001b[2S\u001b[H\u001b[38;5;215;48;5;235m❯ \u001b[1myoloctl\u001b[39;22m space create yolo-team --workdir /var/tmp/demo040/project --account  \u001b[38;5;243mEsc hide palette · ^←/→ tab… · \u001b[38;5;67;1mdefault ▾\u001b[m\u001b[1;79H\u001b[?25h\u001b[?25l\u001b[48;5;235ml \u001b[38;5;243mEsc hide palette · ^←/→ ta\u001b[m\u001b[1;80H\u001b[?25h\u001b[?25l\u001b[48;5;235me \u001b[38;5;243mEsc hide palette · ^←/→ t\u001b[m\u001b[1;81H\u001b[?25h\u001b[?25l\u001b[48;5;235mo \u001b[38;5;243mEsc hide palette · ^←/→ \u001b[m\u001b[1;82H\u001b[?25h\u001b[?25l\u001b[48;5;235mg \u001b[38;5;243mEsc hide palette · ^←/→\u001b[m\u001b[1;83H\u001b[?25h\u001b[?25l\u001b[48;5;235mr \u001b[38;5;243mEsc hide palette · ^←/\u001b[m\u001b[1;84H\u001b[?25h\u001b[?25l\u001b[0 q\u001b[3G\u001b[38;5;215;48;5;235;1m.:.    \u001b[39;22m\u001b[52X\u001b[1;62H\u001b[38;5;243mrunning · ^C interrupt · ^Y detach · ^←/→ tabs\u001b[m\r\n\u001b[38;5;215;48;5;235m❯ \u001b[39myoloctl space create yolo-team --workdir /var/tmp/demo040/project --account leogr\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\u001b[K\n\u001b[3G\u001b[38;5;243mType a yoloctl command and press Enter, for example:\u001b[m\n\u001b[3G\u001b[38;5;243m  box create coder --agent claude\u001b[m\u001b[K\r\n\u001b[38;5;243m    box attach coder\u001b[m\r\n\u001b[38;5;243m    space ls\u001b[m\u001b[1 q\r\u001b[3d\u001b[6L\u001b[38;5;6;48;5;235m•\u001b[39m \u001b[2mhost▸\u001b[38;5;5;22myoloctl\u001b[39m        \u001b[38;5;6musing space:\u001b[39m \u001b[38;5;5myolo-team\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;6;48;5;235m›\u001b[39m \u001b[2mhost▸\u001b[38;5;5;22myoloctl\u001b[39m        VM memory: 15GiB (automatic; override with --memory)\u001b[K\u001b[m\r\n\u001b[38;5;6;48;5;235m›\u001b[39m \u001b[2mhost▸\u001b[38;5;5;22myoloctl\u001b[39m        VM CPUs: 16 (automatic: 16 available logical CPUs; override with --cpus)\u001b[K\u001b[m\r\n\u001b[38;5;6;48;5;235m›\u001b[39m \u001b[2mhost▸\u001b[38;5;5;22myoloctl\u001b[39m        system disk 31 GiB (half of 63 GiB free)\u001b[K\u001b[m\r\n\u001b[38;5;6;48;5;235m⠋\u001b[39m \u001b[2mhost▸\u001b[38;5;5;22myoloctl\u001b[39m        Creating space yolo-team\u001b[K\u001b[m\r\n\u001b[48;5;235m  \u001b[38;5;2m✓\u001b[39m \u001b[38;5;2mPrepari