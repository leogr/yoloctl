h\u001b[?25l\u001b[1;4H\u001b[38;5;215;48;5;235;1m .:.\u001b[m\u001b[15;34H\u001b[?25h\u001b[?25l\r\u001b[8d\u001b[38;5;6;48;5;235m⠸\u001b[39m \u001b[m\n\n\n\u001b[38;5;6;48;5;235m⠸\u001b[39m \u001b[m\u001b[15;34H\u001b[?25h\u001b[?25l\r\n\u001b[L\u001b[1;3H\u001b[38;5;215;48;5;235;1myoloctl\u001b[39;22m\u001b[23X\u001b[1;33H\u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^D quit\u001b[m\r\u001b[8d\u001b[38;5;2;48;5;235m✓\u001b[39m \u001b[2mhost▸\u001b[38;5;5;22myoloctl\u001b[39m        \u001b[38;5;2mCreating space yolo-team\u001b[39m  \u001b[2m16.3s\u001b[m\u001b[11;3H\u001b[38;5;2;48;5;235m✓\u001b[39m \u001b[38;5;2mStarting controller\u001b[39m  \u001b[2m16.3s\u001b[m\r\u001b[5B\u001b[38;5;2;48;5;235m✓\u001b[39m \u001b[38;5;2mexit 0\u001b[39m\u001b[K\u001b[m\u001b[1;11H\u001b[?25h\u001b7\u001b[1;113H\u001b[0;1;97;45m↖\u001b8\u001b[?25l\u001b[0 q\u001b[2;77H\u001b[38;5;243;48;5;235m╭─\u001b[38;5;215;1m Switch space \u001b[38;5;243;22m───────────────────────────╮\u001b[m\r\u001b[3;77H\u001b[38;5;243;48;5;235m│\u001b[39m \u001b[7myolo-team                               \u001b[27m \u001b[38;5;243m│\u001b[m\r\u001b[4;77H\u001b[38;5;243;48;5;235m│\u001b[39m\u001b[42X\u001b[42C\u001b[38;5;243m│\u001b[m\r\u001b[5;77H\u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mSwitches only this TUI\u001b[39m\u001b[19X\t\t\t\t\u001b[38;5;243m│\u001b[m\r\u001b[6;77H\u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;215myoloctl space use\u001b[38;5;243m changes the default\u001b[39m    \u001b[38;5;243m│\u001b[m\r\u001b[7;77H\u001b[38;5;243;48;5;235m╰──────────────────────────────────────────╯\u001b[m\u001b7\u001b[1;113H\u001b[0;1;97;45m↖\u001b8\u001b7\u001b[1;113H\u001b[0;1;38;2;95;135;175;48;2;38;38;38mf\u001b8\u001b7\u001b[1;113H\u001b[0;1;97;45m↖\u001b8\u001b7\u001b[1;113H\u001b[0;1;38;2;95;135;175;48;2;38;38;38mf\u001b8\u001b7\u001b[3;81H\u001b[0;1;97;45m↖\u001b8\u001b7\u001b[3;81H\u001b[0;7;39;48;2;38;38;38ml\u001b8\r\u001b[2;77H\u001b[48;5;235mt leogr\u001b[K\u001b[m\u001b[3;77H\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[48;5;235mrride with --cpus)\u001b[K\u001b[m\u001b[6;77H\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[48;5;235m\u001b[K\u001b[m\u001b[23;19H\u001b[38;5;243;48;5;235m╭─\u001b[38;5;215;1m Switch from default to yolo-team and close all tabs? \u001b[38;5;243;22m───────────────────────────╮\u001b[m\u001b[24;19H\u001b[38;5;243;48;5;235m│\u001b[39m Close 0 tabs / 0 panes. Chat drafts and local view state are lost.\u001b[15X\u001b[24;102H\u001b[38;5;243m│\u001b[m\u001b[25;19H\u001b[38;5;243;48;5;235m│\u001b[39m Established managed sessions keep running; other remote outcomes may be unknown. \u001b[38;5;243m│\u001b[m\u001b[26;19H\u001b[38;5;243;48;5;235m│\u001b[39m\u001b[82X\u001b[26;102H\u001b[38;5;243m│\u001b[m\u001b[27;19H\u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;215;1;7m[ Keep ]\u001b[27m   [ Close tabs & switch ]\u001b[39;22m\u001b[47X\u001b[27;102H\u001b[38;5;243m│\u001b[m\u001b[28;19H\u001b[38;5;243;48;5;235m╰──────────────────────────────────────────────────────────────────────────────────╯\u001b[m\u001b7\u001b[3;81H\u001b[0;1;97;45m↖\u001b8\u001b7\u001b[3;81H\u001b[0;39;48;2;38;38;38m \u001b8\u001b7\u001b[3;81H\u001b[0;1;97;45m↖\u001b8\u001b7\u001b[3;81H\u001b[0;39;48;2;38;38;38m \u001b8\u001b7\u001b[27;37H\u001b[0;1;97;45m↖\u001b8\u001b[1 q\r\u001b[4A\u001b[J\u001b[1;31H\u001b[38;5;243;48;5;235mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^D quit · \u001b[38;5;67;1myolo-team\u001b[m\u001b[23;19H\u001b[K\u001b[1;11H\u001b[?25h\u001b7\u001b[27;37H\u001b[0;1;97;45m↖\u001b8\u001b7\u001b[27;37H\u001b[0;39;49m \u001b8\u001b7\u001b[27;37H\u001b[0;1;97;45m↖\u001b8\u001b7\u001b[27;37H\u001b[0;39;49m \u001b8\u001b[?25l\r\u001b[23d\u001b[J\u001b[20;4H\u001b[38;5;243mip: an operator is an agent that manages boxes for you, with full authority over this space. To create one, type:\u001b[m\n\u001b[5G\u001b[38;5;243;4mbox create space-commander --agent claude --operator --agent-extra-args --model,claude-opus-5-5,--effort,medium\u001b[m\n\u001b[3G\u001b[38;5;243mClick the command to put it in the input.\u001b[m\u001b[1;11H\u001b[?25h\u001b7\u001b[27;37H\u001b[0;1;97;45m↖\u001b8\u001b7\u001b[27;37H\u001b[0;39;49m \u001b8\u001b[?25l\u001b[48;5;235mb \u001b[m\u001b[21;5H\u001b[38;5;243mbox create space-commander --agent claude --operator --agent-extra-args --model,claude-opus-5-5,--effort,medium\u001b[m\u001b[1;12H\u001b[?25h\u001b[?25l\r\u001b[32d\u001b[14S\u001b[H\u001b[38;5;215;48;5;235m❯ \u001b[1myoloctl\u001b[39;22m b\u001b[38;5;243mox\u001b[39m\u001b[17X\u001b[1;31H\u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^D quit · \u001b[38;5;67;1myolo-team ▾\u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ box\u001b[39;22m  \u001b[38;5;243mManage boxes for coding agents, shells and other workloads\u001b[m\u001b[1;12H\u001b[?25h\u001b[?25l\u001b[48;5;235mo\u001b[38;5;243mx\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mx \u001b[m\b\u001b[?25h\u001b[?25l\u001b[C\u001b[?25h\u001b[?25l\n\u001b[3G\u001b[38;5;215;48;5;235;1mattach   \u001b[39;22m  \u001b[38;5;243mAttach to the box's persistent terminal session\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  cache    \u001b[39m  \u001b[38;5;243mManage one box's VM-local caches\u001b[m\r\n\u001b[38;5;67;48;5;235m  copy     \u001b[39m  \u001b[38;5;243mCreate a new box from an existing box's manifest (settings only)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  cp       \u001b[39m  \u001b[38;5;243mCopy files from a running or stopped box to the host\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  create   \u001b[39m  \u001b[38;5;243mCreate a confined box inside a space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  destroy  \u001b[39m  \u001b[38;5;243mStop and remove a box (runtime + its declaration)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  diff     \u001b[39m  \u001b[38;5;243mShow the reconcile plan without applying it (like `reconcile --dry-run`)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  edit     \u001b[39m  \u001b[38;5;243mEdit the box YAML in $EDITOR; reconcile on save\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  exec     \u001b[39m  \u001b[38;5;243mRun a command inside a box via the sandbox SSH socket (kubectl-exec mapping)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  inspect  \u001b[39m  \u001b[38;5;243mRead-only debug view: resolved inputs, computed policy, and reconstructed runtime\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  list     \u001b[39m  \u001b[38;5;243mList declared boxes and their runtime state\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  logs     \u001b[39m  \u001b[38;5;243mStream a box's stdout/stderr\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  reconcile\u001b[39m  \u001b[38;5;243mReconcile a box runtime with its manifest\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  recreate \u001b[39m  \u001b[38;5;243mTear down and rebuild a box container from its persisted YAML\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  restart  \u001b[39m  \u001b[38;5;243mRestart a box (stop its runtime, then start it again)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  session  \u001b[39m  \u001b[38;5;243mShow a box's agent conversation record (read-only)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  set      \u001b[39m  \u001b[38;5;243mMutate scalar box fields and reconcile\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  show     \u001b[39m  \u001b[38;5;243mPrint a box's declaration, runtime, session, and drift state\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  start    \u001b[39m  \u001b[38;5;243mStart or materialize a box from its declaration\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  stop     \u001b[39m  \u001b[38;5;243mGracefully stop a box (lets openshell-sandbox tear down its netns)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  use      \u001b[39m  \u001b[38;5;243mObserve or steer a persistent session, then detach (JSON Lines)\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\n\u001b[38;5;243m  Tip: an operator is an agent that manages boxes for you, with full authority over this space. To create one, type:\u001b[m\r\n\u001b[38;5;243m    box create space-commander --agent claude --operator --agent-extra-args --model,claude-opus-5-5,--effort,medium\u001b[m\r\n\u001b[38;5;243m  Click the command to put it in the input.\u001b[m\u001b[1;15H\u001b[?25h\u001b[?25l\u001b[48;5;235mc \u001b[m\b\u001b[?25h\u001b[?25l\r\u001b[12d\u001b[J\u001b[1;16H\u001b[38;5;243;48;5;235mache\u001b[39m \u001b[m\n\u001b[3G\u001b[38;5;215;48;5;235;1mcache \u001b[39;22m  \u001b[38;5;243mManage one box's VM-local caches\u001b[39m\u001b[K\u001b[m\n\u001b[4G\u001b[38;5;67;48;5;235mopy  \u001b[39m  \u001b[38;5;243mCreate a new box from an existing box's manifest (settings only)\u001b[m\n\u001b[4G\u001b[38;5;67;48;5;235mp    \u001b[39m  \u001b[38;5;243mCopy files from a running or stopped box to the host\u001b[39m\u001b[K\u001b[m\n\u001b[4G\u001b[38;5;67;48;5;235mreate\u001b[39m  \u001b[38;5;243mCreate a confined box inside a space\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\u001b[K\n\u001b[38;5;243m  Tip: an operator is an agent that manages boxes for you, with full authority over this space. To create one, type:\u001b[m\u001b[K\r\n\u001b[38;5;243m    box create space-commander --agent claude --operator --agent-extra-args --model,claude-opus-5-5,--effort,medium\u001b[m\u001b[K\r\n\u001b[38;5;243m  Click the command to put it in the input.\u001b[m\u001b[K\u001b[1;16H\u001b[?25h\u001b[?25l\u001b[48;5;235mr    \u001b[m\u001b[Z\u001b[?25h\u001b[?25l\r\n\u001b[3M\u001b[1;17H\u001b[38;5;243;48;5;235meate\u001b[39m \u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ create\u001b[m\u001b[1;17H\u001b[?25h\u001b[?25l\u001b[48;5;235me\u001b[38;5;243ma\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235ma\u001b[38;5;243mt\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mt\u001b[38;5;243me\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235me \u001b[m\b\u001b[?25h\u001b[?25l\u001b[C\u001b[?25h\u001b[?25l\u001b[48;5;235mc\u001b[38;5;243mreate\u001b[m\u001b[5D\u001b[?25h\u001b[?25l\u001b[48;5;235mo    \u001b[m\u001b[4D\u001b[?25h\u001b[?25l\u001b[48;5;235md \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235me \u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mr \u001b[m\b\u001b[?25h\u001b[?25l\u001b[C\u001b[?25h\u001b[?25l\u001b[48;5;235m- \u001b[m\b\u001b[?25h\u001b[?25l\u001b[38;5;243;48;5;235m-color\u001b[39m \u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^…\u001b[m\n\u001b[3G\u001b[38;5;215;48;5;235;1m--color\u001b[15X\u001b[2;25H\u001b[39;22m  \u001b[38;5;243mColour log output: \"auto\", \"always\" or \"never\"\u001b[m\r\n\u001b[38;5;67;48;5;235m  --log-level           \u001b[39m  \u001b[38;5;243mLog output to show: debug, info, warn, error (debug includes raw tool output)\u001b[m\r\n\u001b[38;5;67;48;5;235m  --quiet\u001b[15X\u001b[4;25H\u001b[39m  \u001b[38;5;243mShow only warnings, errors and final outcomes (same as --log-level warn)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  -q\u001b[20X\u001b[5;25H\u001b[39m  \u001b[38;5;243mShow only warnings, errors and final outcomes (same as --log-level warn)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --account\u001b[13X\u001b[6;25H\u001b[39m  \u001b[38;5;243mAccount this box selects (a plain name, e.g. default or personal). Defaults to the space's in…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --agent\u001b[15X\u001b[7;25H\u001b[39m  \u001b[38;5;243mAgent this box will host ([agy claude codex gemini opencode pi]). Pre-fills --image (the agen…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --agent-extra-args    \u001b[39m  \u001b[38;5;243mExtra args appended after the agent definition's default_args when yoloctl starts a managed a…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --agent-session-resume\u001b[39m  \u001b[38;5;243mConversation policy for agents that declare one (Claude): last resumes the box's own conversa…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --capability          \u001b[39m  \u001b[38;5;243mExplicit positive capability to grant (repeatable), e.g. network.github, or fs.pty.allocate t…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --cpus\u001b[16X\u001b[11;25H\u001b[39m  \u001b[38;5;243mCPU time cap in CPUs, e.g. 2 or 0.5 (omit to share all VM CPUs without a box cap)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --drop-capability     \u001b[39m  \u001b[38;5;243mDrop a capability from the box's default+explicit set (repeatable), e.g. fs.workdir.write. Ca…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --env\u001b[17X\u001b[13;25H\u001b[39m  \u001b[38;5;243mSet a literal environment variable KEY=VALUE in the box (repeatable). Non-secret by conventio…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --feature             \u001b[39m  \u001b[38;5;243mFeature name or OCI reference (repeatable)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --feature-option      \u001b[39m  \u001b[38;5;243mOCI Feature option: FEATURE.OPTION=VALUE (repeatable; non-secret)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --features            \u001b[39m  \u001b[38;5;243mComma-separated feature names (yolo.space.operator, yolo.chat.skill, agy, claude, codex, gemi…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --help\u001b[16X\u001b[17;25H\u001b[39m  \u001b[38;5;243mhelp for create\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  -h\u001b[20X\u001b[18;25H\u001b[39m  \u001b[38;5;243mhelp for create\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --image\u001b[15X\u001b[19;25H\u001b[39m  \u001b[38;5;243mContainer image (overrides the agent image)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --manifest-only       \u001b[39m  \u001b[38;5;243mWrite the box manifest on the running space controller without creating a container. Material…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --memory\u001b[14X\u001b[21;25H\u001b[39m  \u001b[38;5;243mMemory limit (shared uses the VM workload pool; e.g. 2g sets an additional box limit)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --mount\u001b[15X\u001b[22;25H\u001b[39m  \u001b[38;5;243mExtra bind mount source:target[:ro] (repeatable; host source accepts ~ or relative paths, tar…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --no-attach           \u001b[39m  \u001b[38;5;243mSkip the automatic attach to the box's session when the command finishes\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --no-autoupdate       \u001b[39m  \u001b[38;5;243mSkip the agent CLI update after create\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\n\u001b[38;5;243m  Tip: an operator is an agent that manages boxes for you, with full authority over this space. To create one, type:\u001b[m\r\n\u001b[38;5;243m    box create space-commander --agent claude --operator --agent-extra-args --model,claude-opus-5-5,--effort,medium\u001b[m\r\n\u001b[38;5;243m  Click the command to put it in the input.\u001b[m\u001b[1;29H\u001b[?25h\u001b[?25l\u001b[48;5;235m-\u001b[38;5;243mc\u001b[m\b\u001b[?25h\u001b[?25l\u001b[5;17r\u001b[17;1H\n\u001b[1;32r\u001b[17;24r\u001b[24;1H\u001b[2S\u001b[1;32r\u001b[23;1H\u001b[38;5;67;48;5;235m  --operator            \u001b[39m  \u001b[38;5;243mApply the space operator preset: yolo.space.operator + yolo.chat.skill, open networking unles…\u001b[m\r\n\u001b[38;5;67;48;5;235m  --passthrough         \u001b[39m  \u001b[38;