b[m\b\b\b\u001b[38;5;215;48;5;235;1m .:.\u001b[m\b\b\b\u001b[38;5;215;48;5;235;1m .:.\u001b[m\u001b[6G\u001b[38;5;215;48;5;235;1m.:. \u001b[m\u001b[5G\u001b[38;5;215;48;5;235;1m.:. \u001b[m\u001b[1 q\u001b[2;24r\u001b[24;1H\u001b[2S\u001b[1;32r\u001b[1;3H\u001b[38;5;215;48;5;235;1myoloctl\u001b[39;22m\u001b[21X\u001b[1;31H\u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^D quit\u001b[m\r\u001b[23d\u001b[38;5;2;48;5;235m✓\u001b[39m \u001b[2mspace▸\u001b[38;5;5;22mcontroller\u001b[39m    \u001b[38;5;2mbox create completed\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;2;48;5;235m✓\u001b[39m \u001b[38;5;2mexit 0\u001b[39m\u001b[K\u001b[m\u001b[1;11H\u001b[?25h\u001b[?25l\r\u001b[30d\u001b[J\u001b[27;4H\u001b[38;5;243mip: have you ever tried making a new box with another box's settings (not its files)? Type:\u001b[m\n\u001b[5G\u001b[38;5;243;4mbox copy SRC NEW\u001b[m\u001b[K\n\u001b[3G\u001b[38;5;243mClick the command to put it in the input.\u001b[m\u001b[1;11H\u001b[?25h\u001b[?25l\u001b[48;5;235mb \u001b[m\u001b[28;5H\u001b[38;5;243mbox copy SRC NEW\u001b[m\u001b[1;12H\u001b[?25h\u001b[?25l\r\u001b[9d\u001b[J\u001b[1;12H\u001b[38;5;243;48;5;235mox\u001b[39m \u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ box\u001b[39;22m  \u001b[38;5;243mManage boxes for coding agents, shells and other workloads\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\u001b[K\n\u001b[38;5;243m  Tip: have you ever tried making a new box with another box's settings (not its files)? Type:\u001b[m\u001b[K\r\n\u001b[38;5;243m    box copy SRC NEW\u001b[m\u001b[K\r\n\u001b[38;5;243m  Click the command to put it in the input.\u001b[m\u001b[K\u001b[1;12H\u001b[?25h\u001b[?25l\u001b[48;5;235mo\u001b[38;5;243mx\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mx \u001b[m\b\u001b[?25h\u001b[?25l\u001b[C\u001b[?25h\u001b[?25l\n\u001b[3G\u001b[38;5;215;48;5;235;1mattach   \u001b[39;22m  \u001b[38;5;243mAttach to the box's persistent terminal session\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  cache    \u001b[39m  \u001b[38;5;243mManage one box's VM-local caches\u001b[m\r\n\u001b[38;5;67;48;5;235m  copy     \u001b[39m  \u001b[38;5;243mCreate a new box from an existing box's manifest (settings only)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  cp       \u001b[39m  \u001b[38;5;243mCopy files from a running or stopped box to the host\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  create   \u001b[39m  \u001b[38;5;243mCreate a confined box inside a space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  destroy  \u001b[39m  \u001b[38;5;243mStop and remove a box (runtime + its declaration)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  diff     \u001b[39m  \u001b[38;5;243mShow the reconcile plan without applying it (like `reconcile --dry-run`)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  edit     \u001b[39m  \u001b[38;5;243mEdit the box YAML in $EDITOR; reconcile on save\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  exec     \u001b[39m  \u001b[38;5;243mRun a command inside a box via the sandbox SSH socket (kubectl-exec mapping)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  inspect  \u001b[39m  \u001b[38;5;243mRead-only debug view: resolved inputs, computed policy, and reconstructed runtime\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  list     \u001b[39m  \u001b[38;5;243mList declared boxes and their runtime state\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  logs     \u001b[39m  \u001b[38;5;243mStream a box's stdout/stderr\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  reconcile\u001b[39m  \u001b[38;5;243mReconcile a box runtime with its manifest\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  recreate \u001b[39m  \u001b[38;5;243mTear down and rebuild a box container from its persisted YAML\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  restart  \u001b[39m  \u001b[38;5;243mRestart a box (stop its runtime, then start it again)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  session  \u001b[39m  \u001b[38;5;243mShow a box's agent conversation record (read-only)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  set      \u001b[39m  \u001b[38;5;243mMutate scalar box fields and reconcile\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  show     \u001b[39m  \u001b[38;5;243mPrint a box's declaration, runtime, session, and drift state\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  start    \u001b[39m  \u001b[38;5;243mStart or materialize a box from its declaration\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  stop     \u001b[39m  \u001b[38;5;243mGracefully stop a box (lets openshell-sandbox tear down its netns)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  use      \u001b[39m  \u001b[38;5;243mObserve or steer a persistent session, then detach (JSON Lines)\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\n\u001b[38;5;243m  Tip: have you ever tried making a new box with another box's settings (not its files)? Type:\u001b[m\r\n\u001b[38;5;243m    box copy SRC NEW\u001b[m\r\n\u001b[38;5;243m  Click the command to put it in the input.\u001b[m\u001b[1;15H\u001b[?25h\u001b[?25l\u001b[48;5;235ml \u001b[m\b\u001b[?25h\u001b[?25l\r\u001b[9B\u001b[J\u001b[1;16H\u001b[38;5;243;48;5;235mist\u001b[39m \u001b[m\n\u001b[3G\u001b[38;5;215;48;5;235;1mlist\u001b[39;22m  \u001b[38;5;243mList declared boxes and their runtime state\u001b[39m\u001b[K\u001b[m\n\u001b[3G\u001b[38;5;67;48;5;235mlogs\u001b[39m  \u001b[38;5;243mStream a box's stdout/stderr\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\u001b[K\n\u001b[38;5;243m  Tip: have you ever tried making a new box with another box's settings (not its files)? Type:\u001b[m\u001b[K\r\n\u001b[38;5;243m    box copy SRC NEW\u001b[m\u001b[K\r\n\u001b[38;5;243m  Click the command to put it in the input.\u001b[m\u001b[K\u001b[1;16H\u001b[?25h\u001b[?25l\u001b[48;5;235mi\u001b[38;5;243ms\u001b[m\b\u001b[?25h\u001b[?25l\r\n\n\u001b[M\u001b[1;17H\u001b[?25h\u001b[?25l\u001b[48;5;235ms\u001b[38;5;243mt\u001b[m\b\u001b[?25h\u001b[?25l\u001b[48;5;235mt \u001b[m\b\u001b[?25h\u001b[?25l\u001b[0 q\u001b[3G\u001b[38;5;215;48;5;235;1m.:.    \u001b[39;22m\u001b[50X\u001b[1;60H\u001b[38;5;243mrunning · ^C interrupt · ^Y detach · ^←/→ tabs\u001b[m\r\n\u001b[38;5;215;48;5;235m❯ \u001b[39myoloctl box list\u001b[K\u001b[m\u001b[6;4H\u001b[38;5;243mype a yoloctl command and press Enter, for example:\u001b[m\u001b[K\u001b[7;10H\u001b[38;5;243mreate coder --agent claude\u001b[m\n\u001b[3G\u001b[38;5;243m  box attach coder\u001b[m\u001b[K\r\n\u001b[38;5;243m    space ls\u001b[m\u001b[1;3H\u001b[38;5;215;48;5;235;1m .:.\u001b[m\b\b\b\u001b[38;5;215;48;5;235;1m .:.\u001b[m\b\b\b\u001b[38;5;215;48;5;235;1m .:.\u001b[m\b\b\b\u001b[38;5;215;48;5;235;1m .:.\u001b[m\u001b[6G\u001b[38;5;215;48;5;235;1m.:. \u001b[m\r\n\n\u001b[6L\u001b[48;5;235mNAME\u001b[13X\u001b[3;18HSTATE    AGENT   WORKDIR\u001b[19X\u001b[3;61HSESSION  IMAGE\u001b[26X\u001b[3;101HREASON\u001b[K\u001b[m\r\n\u001b[48;5;235mchat\u001b[13X\u001b[4;18Hrunning  none    ephemeral\u001b[17X\u001b[4;61Hrunning  yoloctl/agentbox:ubuntu-24.04  container_running\u001b[K\u001b[m\r\n\u001b[48;5;235mcoder            running  claude  /var/tmp/demo040/project  running  yoloctl/agentbox:ubuntu-24.04  container_running\u001b[K\u001b[m\r\n\u001b[48;5;235mreviewer         running  codex   /var/tmp/demo040/project  running  yoloctl/agentbox:ubuntu-24.04  container_running\u001b[K\u001b[m\r\n\u001b[48;5;235mspace-commander  running  codex   /var/tmp/demo040/project  running  yoloctl/agentbox:ubuntu-24.04  container_running\u001b[K\u001b[m\r\n\u001b[48;5;235mtester           running  codex   /var/tmp/demo040/project  running  yoloctl/agentbox:ubuntu-24.04  container_running\u001b[K\u001b[m\u001b[1 q\r\n\u001b[L\u001b[1;3H\u001b[38;5;215;48;5;235;1myoloctl\u001b[39;22m\u001b[21X\u001b[1;31H\u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^D quit\u001b[m\r\u001b[9d\u001b[38;5;2;48;5;235m✓\u001b[39m \u001b[38;5;2mexit 0\u001b[39m\u001b[K\u001b[m\u001b[1;11H\u001b[?25h\u001b[?25l\r\u001b[16d\u001b[J\u001b[13;4H\u001b[38;5;243mip: have you ever tried a live, clickable view of your space? Type:\u001b[m\n\u001b[5G\u001b[38;5;243;4mspace view\u001b[m\u001b[K\n\u001b[3G\u001b[38;5;243mClick the command to put it in the input.\u001b[m\u001b[1;11H\u001b[?25h\u001b[?25l\u001b[48;5;235ma \u001b[m\u001b[14;5H\u001b[38;5;243mspace view\u001b[m\u001b[1;12H\u001b[?25h\u001b[?25l\r\n\n\n\u001b[4M\u001b[1;12H\u001b[38;5;243;48;5;235mccount\u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ account\u001b[39;22m  \u001b[38;5;243mManage accounts (identity keychains: provider secrets + per-agent state)\u001b[m\r\n\u001b[38;5;67;48;5;235m  agent  \u001b[39m  \u001b[38;5;243mManage agents (catalog) and agent CLI tooling (Antigravity, Claude Code, Codex, Gemini, OpenCode, Pi)\u001b[m\r\n\u001b[38;5;67;48;5;235m  attach \u001b[39m  \u001b[38;5;243mAttach to the box's persistent terminal session\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  audit  \u001b[39m  \u001b[38;5;243mView opt-in VM security audit events\u001b[m\u001b[1;12H\u001b[?25h\u001b[?25l\u001b[48;5;235mt     \u001b[m\u001b[5D\u001b[?25h\u001b[?25l\r\n\u001b[3M\u001b[1;13H\u001b[38;5;243;48;5;235mtach\u001b[39m \u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ attach\u001b[39;22m  \u001b[38;5;243mAttach to the box's persistent termina