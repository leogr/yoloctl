[34.145827, "o", "\u001b[?25l\n\u001b[3G\u001b[38;5;215;48;5;235;1mcreate   \u001b[39;22m  \u001b[38;5;243mCreate a space with a required workdir and initial account\u001b[m\r\n\u001b[38;5;67;48;5;235m  destroy  \u001b[39m  \u001b[38;5;243mDelete a space, its accounts and declarations\u001b[m\r\n\u001b[38;5;67;48;5;235m  edit     \u001b[39m  \u001b[38;5;243mEdit a stopped space's CPU, memory and system disk allocation in $EDITOR\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  export   \u001b[39m  \u001b[38;5;243mBack up declarations and native account state\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  import   \u001b[39m  \u001b[38;5;243mRestore a backup into a new space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  list     \u001b[39m  \u001b[38;5;243mList yoloctl spaces\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  logs     \u001b[39m  \u001b[38;5;243mStream the VM boot/runtime log for a space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  mount    \u001b[39m  \u001b[38;5;243mManage a space's host→VM mount grants\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  operation\u001b[39m  \u001b[38;5;243mInspect recorded controller mutation outcomes\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  recreate \u001b[39m  \u001b[38;5;243mReplace and start the VM, preserving accounts and declarations\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  set      \u001b[39m  \u001b[38;5;243mChange a stopped space's CPU, memory and system disk allocation\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  show     \u001b[39m  \u001b[38;5;243mShow one space's VM config, workdirs, and box inventory\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  ssh      \u001b[39m  \u001b[38;5;243mOpen a shell in a space's VM (VM-level access, outside the OpenShell sandbox)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  start    \u001b[39m  \u001b[38;5;243mStart a yoloctl space (recreating the VM from its bundle if needed)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  stop     \u001b[39m  \u001b[38;5;243mStop a yoloctl space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  storage  \u001b[39m  \u001b[38;5;243mShow what fills the VM's system and data disks\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  use      \u001b[39m  \u001b[38;5;243mShow or switch the current-context space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  view     \u001b[39m  \u001b[38;5;243mShow a live, clickable view of a space's boxes and resources\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;67;48;5;235;4m \u001b[1m ❶ ✳  leogr\\coordinator: Claude … \u001b[38;5;243;58;5;67;22m✕\u001b[38;5;67;59;1m \u001b[38;5;215;49;24m ❷ \u001b[38;2;217;119;87m✳\u001b[38;5;215m  leogr\\dev: Claude Code ✕ \u001b[38;5;67;48;5;235;4m ❸ >_ leogr\\reviewer: Start AIRC… \u001b[38;5;243;58;5;67;22m✕\u001b[38;5;67;59;1m \u001b[22m                \u001b[m\r\u001b[22;61H\u001b[38;5;67m│\u001b[38;5;174;48;2;0;0;0;1m ◈ \u001b[38;5;255mshowcase\u001b[39;22m \u001b[38;5;174;1m#space\u001b[38;5;243;22m  4 online\u001b[39m\u001b[24X\t\t\t \u001b[38;5;108;1m◉ LIVE\u001b[39;22m\u001b[K\u001b[m\r\n\u001b[38;5;174m ▐\u001b[48;5;16m▛███▛█\u001b[m   \u001b[1mClaude Code\u001b[m \u001b[38;5;246mv2.1.318\u001b[m\u001b[29X\u001b[23;61H\u001b[38;5;67m│\u001b[38;5;223m▌\u001b[m   \u001b[38;5;252mdev qualify the opening and link the privileged-box \u001b[m\r\n\u001b[38;5;174m▝▜\u001b[48;5;16m█████\u001b[49m█▀\u001b[m  \u001b[38;5;246mOpus 5.5 · Claude Ultra\u001b[m\u001b[26X\u001b[24;61H\u001b[38;5;67m│\u001b[38;5;223m▌\u001b[m   \u001b[38;5;252mexception if \u001b[38;5;230;48;5;94;1m@leogr\u001b[38;5;252;49;22m wants it.\u001b[m\r\n\u001b[38;5;174m ▝▝   ▝▝ \u001b[m  \u001b[38;5;246m/workdir/var/tmp/showcase/work/yoloctl\u001b[m           \u001b[38;5;67m│\u001b[m\u001b[K\n\b\u001b[38;5;67m│\u001b[m \u001b[38;2;217;119;87;1m✳  dev\u001b[38;5;243;22m  15:05\u001b[m\u001b[K\u001b[27;61H\u001b[38;5