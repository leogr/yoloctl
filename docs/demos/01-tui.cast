[35.012793, "o", "\u001b7\u001b[?6l\u001b[32;1H\u001b[0;38;2;118;118;118;48;2;38;38;38mLoading · bytes 0–0/0 · following · text · r refresh · f/End follow · Ctrl+S source · y copy · q quit\u001b[0;39;48;2;38;38;38m                   \u001b[0m\u001b8\r\u001b[3d\u001b[38;5;215;1mPlan: GET /health\u001b[m\r\n\n\u001b[38;5;252mAdd a liveness endpoint to the hello service.\u001b[m\r\n\n\u001b[48;5;236m \u001b[38;5;243mmermaid\u001b[39m\u001b[23X\u001b[7;32H\u001b[38;5;110mcopy\u001b[39m \u001b[m\r\n\u001b[48;5;236m \u001b[38;5;252m┌──────┐     ┌──────┐     ┌──────┐\u001b[39m \u001b[m\r\n\u001b[48;5;236m \u001b[38;5;252m│ Plan ├────→│ Code ├────→│ Test │\u001b[39m \u001b[m\r\n\u001b[48;5;236m \u001b[38;5;252m└──────┘     └──────┘     └──────┘\u001b[39m \u001b[m\r\n\n\n\u001b[38;5;252;1mSteps\u001b[m\r\n\n\u001b[38;5;252m1. \u001b[1mPlan\u001b[22m – this document.\u001b[m\r\n\u001b[38;5;252m2. \u001b[1mCode\u001b[22m – in \u001b[38;5;215mmain.go\u001b[38;5;252m, add \u001b[38;5;215mhealthHandler\u001b[38;5;252m that only answers \u001b[38;5;215mGET\u001b[m\r\n\u001b[38;5;252m   (other methods get \u001b[38;5;215m405 Method Not Allowed\u001b[38;5;252m with an \u001b[38;5;215mAllow: GET\u001b[38;5;252m header).\u001b[m\r\n\u001b[38;5;252m   It returns \u001b[38;5;215m200 OK\u001b[38;5;252m with \u001b[38;5;215mContent-Type: application/json\u001b[38;5;252m and the body\u001b[m\r\n\u001b[38;5;252m   \u001b[38;5;215m{\"status\":\"ok\"}\\n\u001b[38;5;252m. Register it in \u001b[38;5;215mnewMux()\u001b[38;5;252m at \u001b[38;5;215m/health\u001b[38;5;252m.\u001b[m\r\n\u001b[38;5;252m   \u001b[38;5;215m/\u001b[38;5;252m keeps serving \u001b[38;5;215mhello\u001b[38;5;252m.\u001b[m\r\n\u001b[38;5;252m3. \u001b[1mTest\u001b[22m – in \u001b[38;5;215mmain_test.go\u001b[38;5;252m, add \u001b[38;5;215mTestHealth\u001b[38;5;252m (GET → 200, JSON content\u001b[m\r\n\u001b[38;5;252m   type, exact body) and \u001b[38;5;215mTestHealthMethodNotAllowed\u001b[38;5;252m (POST → 405). The\u001b[m\r\n\u001b[38;5;252m   tester runs \u001b[38;5;215mgo test ./...\u001b[38;5;252m.\u001b[m\r\u001b[9B\u001b[38;5;243;48;5;235mbytes 0–669/669 · following · Markdown \u001b[39m\u001b[2P\u001b[m\u001b7\u001b[?6l\u001b[32;1H\u001b[0;1;97;48;5;24m a plan link opens follow: the diagram is drawn                                                                         \u001b[0m\u001b8"]
