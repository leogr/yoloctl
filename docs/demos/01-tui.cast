[3.0, "o", "\u001bc\u001b[?2026$p\u001b[?2027$p\u001b[16t\u001b]11;?\u0007\u001b]10;?\u0007\u001b[?9l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1005l\u001b[?1006l\u001b[?1015l\u001b[?1016l\u001b[?1006h\u001b[?1002h\u001b[?1016$p\u001b]4;0;?\u001b\\\u001b]4;1;?\u001b\\\u001b]4;2;?\u001b\\\u001b]4;3;?\u001b\\\u001b]4;4;?\u001b\\\u001b]4;5;?\u001b\\\u001b]4;6;?\u001b\\\u001b]4;7;?\u001b\\\u001b]4;8;?\u001b\\\u001b]4;9;?\u001b\\\u001b]4;10;?\u001b\\\u001b]4;11;?\u001b\\\u001b]4;12;?\u001b\\\u001b]4;13;?\u001b\\\u001b]4;14;?\u001b\\\u001b]4;15;?\u001b\\\u001b]4;16;?\u001b\\\u001b]4;17;?\u001b\\\u001b]4;18;?\u001b\\\u001b]4;19;?\u001b\\\u001b]4;20;?\u001b\\\u001b]4;21;?\u001b\\\u001b]4;22;?\u001b\\\u001b]4;23;?\u001b\\\u001b]4;24;?\u001b\\\u001b]4;25;?\u001b\\\u001b]4;26;?\u001b\\\u001b]4;27;?\u001b\\\u001b]4;28;?\u001b\\\u001b]4;29;?\u001b\\\u001b]4;30;?\u001b\\\u001b]4;31;?\u001b\\\u001b]4;32;?\u001b\\\u001b]4;33;?\u001b\\\u001b]4;34;?\u001b\\\u001b]4;35;?\u001b\\\u001b]4;36;?\u001b\\\u001b]4;37;?\u001b\\\u001b]4;38;?\u001b\\\u001b]4;39;?\u001b\\\u001b]4;40;?\u001b\\\u001b]4;41;?\u001b\\\u001b]4;42;?\u001b\\\u001b]4;43;?\u001b\\\u001b]4;44;?\u001b\\\u001b]4;45;?\u001b\\\u001b]4;46;?\u001b\\\u001b]4;47;?\u001b\\\u001b]4;48;?\u001b\\\u001b]4;49;?\u001b\\\u001b]4;50;?\u001b\\\u001b]4;51;?\u001b\\\u001b]4;52;?\u001b\\\u001b]4;53;?\u001b\\\u001b]4;54;?\u001b\\\u001b]4;55;?\u001b\\\u001b]4;56;?\u001b\\\u001b]4;57;?\u001b\\\u001b]4;58;?\u001b\\\u001b]4;59;?\u001b\\\u001b]4;60;?\u001b\\\u001b]4;61;?\u001b\\\u001b]4;62;?\u001b\\\u001b]4;63;?\u001b\\\u001b]4;64;?\u001b\\\u001b]4;65;?\u001b\\\u001b]4;66;?\u001b\\\u001b]4;67;?\u001b\\\u001b]4;68;?\u001b\\\u001b]4;69;?\u001b\\\u001b]4;70;?\u001b\\\u001b]4;71;?\u001b\\\u001b]4;72;?\u001b\\\u001b]4;73;?\u001b\\\u001b]4;74;?\u001b\\\u001b]4;75;?\u001b\\\u001b]4;76;?\u001b\\\u001b]4;77;?\u001b\\\u001b]4;78;?\u001b\\\u001b]4;79;?\u001b\\\u001b]4;80;?\u001b\\\u001b]4;81;?\u001b\\\u001b]4;82;?\u001b\\\u001b]4;83;?\u001b\\\u001b]4;84;?\