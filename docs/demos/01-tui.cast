[0.000717, "o", "\u001b[>4m\u001b[?1049h\u001b[?5W\u001b[?2004h\u001b[?1004h\u001b]2;yoloctl\u0007\u001b[>4;2m\u001b[>31u\u001b[?u\u001b[1 q\u001b[H\u001b[2J\u001b[38;5;215;48;5;235m❯ \u001b[1myoloctl\u001b[39;22m\u001b[48X\u001b[1;58H\u001b[38;5;243mEsc hide palette · ^Q panes · ^←/→ tabs · ^D quit · \u001b[38;5;67;1m(showcase)\u001b[39;22m\u001b[K\u001b[m\r\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\n\u001b[38;5;243m  type a yoloctl command and press Enter\u001b[m\r\n\u001b[38;5;243m  e.g.: box create coder --agent claude · box attach coder · space ls\u001b[m\u001b[1;11H\u001b[?25h"]
