[3.851091, "o", "\u001b[1 q\r\n\n\u001b[6L\u001b[1;3H\u001b[38;5;215;48;5;235;1myoloctl\u001b[39;22m\u001b[48X\u001b[1;58H\u001b[38;5;243mEsc hide palette · ^Q panes · ^←/→ tabs · ^D quit\u001b[m\r\n\n\u001b[48;5;235mNAME         STATE    AGENT   WORKDIR\u001b[25X\u001b[3;63HSESSION  IMAGE\u001b[26X\u001b[3;103HREASON\u001b[K\u001b[m\r\n\u001b[48;5;235mchat         running  none    ephemeral\u001b[23X\u001b[4;63Hrunning  yoloctl/agentbox:ubuntu-24.04  container_running\u001b[K\u001b[m\r\n\u001b[48;5;235mcoordinator  running  claude  ephemeral\u001b[23X\u001b[5;63Hrunning  yoloctl/agentbox:ubuntu-24.04  container_running\u001b[K\u001b[m\r\n\u001b[48;5;235mdev          running  claude  /var/tmp/showcase/work/yoloctl  running  yoloctl/agentbox:ubuntu-24.04  container_running\u001b[K\u001b[m\r\n\u001b[48;5;235mreviewer     running  codex   /var/tmp/showcase/work/yoloctl  running  yoloctl/agentbox:ubuntu-24.04  container_running\u001b[K\u001b[m\r\n\u001b[38;5;2;48;5;235m✓ exit 0\u001b[39m\u001b[K\u001b[m\u001b[1;11H\u001b[?25h"]
[5.851091, "o", "\u001b[?25l\r\n\n\u001b[4M\u001b[1;11H\u001b[48;5;235ma\u001b[38;5;243mccount\u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ account\u001b[39;22m  \u001b[38;5;243mManage accounts (identity keychains: provider secrets + per-agent state)\u001b[m\r\n\u001b[38;5;67;48;5;235m  agent  \u001b[39m  \u001b[38;5;243mManage agents (catalog) and agent CLI tooling (Antigravity, Claude Code, Codex, Gemini, OpenCode, Pi)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  attach \u001b[39m  \u001b[38;5;243mAttach to the box's persistent terminal session\u001b[m\u001b[1;12H\u001b[?25h"]
