[24.967439, "o", "\u001b[?25l\n\u001b[3G\u001b[38;5;215;48;5;235;1mattach   \u001b[39;22m  \u001b[38;5;243mAttach to the box's persistent terminal session\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  cache    \u001b[39m  \u001b[38;5;243mManage one box's VM-local caches\u001b[m\r\n\u001b[38;5;67;48;5;235m  copy     \u001b[39m  \u001b[38;5;243mCreate a new box from an existing box's manifest (settings only)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  cp       \u001b[39m  \u001b[38;5;243mCopy files from a running or stopped box to the host\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  create   \u001b[39m  \u001b[38;5;243mCreate a confined box inside a space\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  destroy  \u001b[39m  \u001b[38;5;243mStop and remove a box (runtime + its declaration)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  diff     \u001b[39m  \u001b[38;5;243mShow the reconcile plan without applying it (like `reconcile --dry-run`)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  edit     \u001b[39m  \u001b[38;5;243mEdit the box YAML in $EDITOR; reconcile on save\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  exec     \u001b[39m  \u001b[38;5;243mRun a command inside a box via the sandbox SSH socket (kubectl-exec mapping)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  inspect  \u001b[39m  \u001b[38;5;243mRead-only debug view: resolved inputs, computed policy, and reconstructed runtime\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  list     \u001b[39m  \u001b[38;5;243mList declared boxes and their runtime state\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  logs     \u001b[39m  \u001b[38;5;243mStream a box's stdout/stderr\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  reconcile\u001b[39m  \u001b[38;5;243mReconcile a box runtime with its manifest\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  recreate \u001b[39m  \u001b[38;5;243mTear down and rebuild a box container from its persisted YAML\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  restart  \u001b[39m  \u001b[38;5;243mRestart a box (stop its runtime, then start it again)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  session  \u001b[39m  \u001b[38;5;243mShow a box's agent conversation record (read-only)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  set      \u001b[39m  \u001b[38;5;243mMutate scalar box fields and reconcile\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  show     \u001b[39m  \u001b[38;5;243mPrint a box's declaration, runtime, session, and drift state\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  start    \u001b[39m  \u001b[38;5;243mStart or materialize a box from its declaration\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  stop     \u001b[39m  \u001b[38;5;243mGracefully stop a box (lets openshell-sandbox tear down its netns)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  use      \u001b[39m  \u001b[38;5;243mObserve or steer a persistent session, then detach (JSON Lines)\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\n\u001b[38;5;243m  Tip: an operator is an agent that manages boxes for you, with full authority over this space. To create one, type:\u001b[m\r\n\u001b[38;5;243m    box create space-commander --agent claude --operator --agent-extra-args --model,claude-opus-5-5,--effort,medium\u001b[m\r\n\u001b[38;5;243m  Click the command to put it in the input.\u001b[m\u001b[1;15H\u001b[?25h"]
[25.166803, "o", "\u001b[?25l\r\u001b[9d\u001b[J\u001b[1;15H\u001b[48;5;235mi\u001b[38;5;243mnspect\u001b[m\n\u001b[3G\u001b[38;5;215;48;5;235;1minspect\u001b[39;22m  \u001b[38;5;243mRead-only debug view: resolved inputs, computed policy, and reconstructed runtime\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\u001b[K\n\u001b[38;5;243m  Tip: an operator is an agent that manages boxes for you, with full authority over this space. To create one, type:\u001b[m\u001b[K\r\n\u001b[38;5;243m    box create space-commander --agent claude --operator --agent-extra-args --model,claude-opus-5-5,--effort,medium\u001b[m\u001b[K\r\n\u001b[38;5;243m  Click the command to put it in the input.\u001b[m\u001b[K\u001b[1;16H\u001b[?25h"]
