[51.767023, "o", "\u001b[?25l\r\n\u001b[8L\u001b[1;29H\u001b[48;5;235m-\u001b[38;5;243m-color\u001b[39m \u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · …\u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ --color    \u001b[39;22m  \u001b[38;5;243mColour log output: \"auto\", \"always\" or \"never\"\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --log-level\u001b[39m  \u001b[38;5;243mLog output to show: debug, info, warn, error (debug includes raw tool output)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --quiet    \u001b[39m  \u001b[38;5;243mShow only warnings, errors and final outcomes (same as --log-level warn)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  -q         \u001b[39m  \u001b[38;5;243mShow only warnings, errors and final outcomes (same as --log-level warn)\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --help     \u001b[39m  \u001b[38;5;243mhelp for exec\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  -h         \u001b[39m  \u001b[38;5;243mhelp for exec\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;67;48;5;235m  --space    \u001b[39m  \u001b[38;5;243mSpace hosting the box (omit to use the current space selection)\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\u001b[1;30H\u001b[?25h"]
