[22.234189, "o", "\u001b[1 q\u001b[2;24r\u001b[24;1H\n\u001b[1;32r\u001b[1;3H\u001b[38;5;215;48;5;235;1myoloctl\u001b[39;22m\u001b[48X\u001b[1;58H\u001b[38;5;243mEsc hide palette · ^Q panes · ^←/→ tabs · ^D quit\u001b[m\r\u001b[24d\u001b[38;5;2;48;5;235m✓ exit 0\u001b[39m\u001b[K\u001b[m\u001b[1;11H\u001b[?25h"]
[24.234189, "o", "\u001b[?25l\r\u001b[6d\u001b[J\u001b[1;11H\u001b[48;5;235mb \u001b[m\r\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\u001b[K\n\u001b[38;5;243m  type a yoloctl command and press Enter\u001b[m\u001b[K\r\n\u001b[38;5;243m  e.g.: box create coder --agent claude · box attach coder · space ls\u001b[m\u001b[K\u001b[1;12H\u001b[?25h"]
[24.250845, "o", "\u001b[?25l\r\n\u001b[2L\u001b[1;12H\u001b[38;5;243;48;5;235mox\u001b[39m \u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ box\u001b[39;22m  \u001b[38;5;243mManage boxes (sandboxed containers, 1:1 with a coding agent)\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\u001b[1;12H\u001b[?25h"]
