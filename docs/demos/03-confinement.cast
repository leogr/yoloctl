[18.434331, "o", "\u001b[1;3H\u001b[38;5;215;48;5;235;1m .:.\u001b[m\r\n\u001b[48;5;235mt group sandbox >/dev/null; then     YOLOCTL_HOST_UID=1000 YOLOCTL_HOST_GID=985 /usr/local/bin/yoloctl-entrypoint /bin/t\u001b[m\r\n\u001b[48;5;235mrue; fi\u001b[K\u001b[m\r\n\u001b[48;5;235m#7 CACHED\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[48;5;235m#8 [stage-1 1/3] RUN --mount=type=cache,id=yoloctl-npm-v1,target=/var/cache/yoloctl/npm,sharing=locked,mode=0777     npm\u001b[m\r\n\u001b[48;5;235m install -g @anthropic-ai/claude-code@latest --prefix=/home/sandbox/.npm-global --cache=\"/var/cache/yoloctl/npm/$(id -u)\u001b[m\r\n\u001b[48;5;235m\" --prefer-online     && if [ \"$(id -u)\" = 0 ] && id -u sandbox >/dev/null 2>&1 && getent group sandbox >/dev/null; then\u001b[m\r\u001b[9;9H\u001b[48;5;235m\u001b[1K find /home/sandbox/.npm-global -xdev ( ! -user sandbox -o ! -group sandbox ) -exec chown -h sandbox:sandbox {}\u001b[m\r\n\u001b[48;5;235m+; fi\u001b[K\u001b[m\n\u001b[2G\u001b[48;5;235m8 CACHED\u001b[K\u001b[m\n\n\u001b[2G\u001b[48;5;235m9 [stage-1 2/3] RUN <<'AGENT_OBSERVE_INSTALL' (#!/bin/sh...)\u001b[m\n\u001b[2G\u001b[48;5;235m9 CACHED\u001b[K\u001b[m\n\n\u001b[2G\u001b[48;5;235m10 [stage-1 3/3] RUN find /home/sandbox -xdev ( ! -user sandbox -o ! -group sandbox ) -exec chown -h sandbox:sandbox {}\u001b[m\r\n\u001b[48;5;235m +     && YOLOCTL_HOST_UID=1000 YOLOCTL_HOST_GID=985 /usr/local/bin/yoloctl-entrypoint /bin/true\u001b[m\r\n\u001b[48;5;235m#10 CACHED\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[48;5;235m#11 exporting to image\u001b[K\u001b[m\n\u001b[2G\u001b[48;5;235m11 exporting layers done\u001b[K\u001b[m\r\n\u001b[48;5;235m#11 preparing layers for inline cache 0.1s done\u001b[K\u001b[m\n\u001b[2G\u001b[48;5;235m11 exporting manifest sha256:00186641211736aebd7a143036444c1c2d580313abffe213d9ca60dc51dd4f3a 0.0s done\u001b[K\u001b[m\r\n\u001b[48;5;235m#11 exporting config sha256:2a12a733641a2ad040a98db0acc8236056b6baee12ed31b5e62ae787ab1257f2\u001b[