[3.000829, "o", "\u001b[>4m\u001b[?1049h\u001b[?5W\u001b[?2004h\u001b[?1004h\u001b]2;yoloctl\u0007\u001b[>4;2m\u001b[>31u\u001b[?u\u001b[1 q\u001b[H\u001b[2J\u001b[38;5;215;48;5;235m❯ \u001b[1myoloctl\u001b[39;22m\u001b[21X\u001b[1;31H\u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^D quit · \u001b[38;5;67;1myolo-team ▾\u001b[39;22m\u001b[K\u001b[m\r\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\n\u001b[38;5;243m  Type a yoloctl command and press Enter, for example:\u001b[m\r\n\u001b[38;5;243m    box create coder --agent claude\u001b[m\r\n\u001b[38;5;243m    box attach coder\u001b[m\r\n\u001b[38;5;243m    space ls\u001b[m\u001b[1;11H\u001b[?25h"]
[3.267819, "o", "\u001b[?25l\r\u001b[7d\u001b[J\u001b[4;4H\u001b[38;5;243mip: an operator is an agent that manages boxes for you, with full authority over this space. To create one, type:\u001b[m\n\u001b[5G\u001b[38;5;243;4mbox create space-commander --agent claude --operator --agent-extra-args --model,claude-opus-5-5,--effort,medium\u001b[m\n\u001b[3G\u001b[38;5;243mClick the command to put it in the input.\u001b[m\u001b[1;11H\u001b[?25h"]
[5.267819, "o", "\u001b[?25l\u001b[48;5;235mb \u001b[m\u001b[5;5H\u001b[38;5;243mbox create space-commander --agent claude --operator --agent-extra-args --model,claude-opus-5-5,--effort,medium\u001b[m\u001b[1;12H\u001b[?25h"]
[5.28493, "o", "\u001b[?25l\r\n\u001b[2L\u001b[1;12H\u001b[38;5;243;48;5;235mox\u001b[39m \u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ box\u001b[39;22m  \u001b[38;5;243mManage boxes for coding agents, shells and other workloads\u001b[39m\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\u001b[1;12H\u001b[?25h"]
