[22.35136, "o", "\u001b[1 q\r\u001b[9B\u001b[2L\u001b[1;3H\u001b[38;5;215;48;5;235;1myoloctl\u001b[39;22m\u001b[21X\u001b[1;31H\u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^D quit\u001b[m\r\u001b[9B\u001b[38;5;2;48;5;235m✓\u001b[39m \u001b[2mspace▸\u001b[38;5;5;22mcontroller\u001b[39m    \u001b[38;5;2mbox create completed\u001b[39m\u001b[K\u001b[m\r\n\u001b[38;5;2;48;5;235m✓\u001b[39m \u001b[38;5;2mexit 0\u001b[39m\u001b[K\u001b[m\u001b[1;11H\u001b[?25h"]
[22.667664, "o", "\u001b[?25l\r\u001b[18d\u001b[J\u001b[15;4H\u001b[38;5;243mip: an operator is an agent that manages boxes for you, with full authority over this space. To create one, type:\u001b[m\n\u001b[5G\u001b[38;5;243;4mbox create space-commander --agent claude --operator --agent-extra-args --model,claude-opus-5-5,--effort,medium\u001b[m\n\u001b[3G\u001b[38;5;243mClick the command to put it in the input.\u001b[m\u001b[1;11H\u001b[?25h"]
[24.667664, "o", "\u001b[?25l\u001b[48;5;235mb \u001b[m\u001b[16;5H\u001b[38;5;243mbox create space-commander --agent claude --operator --agent-extra-args --model,claude-opus-5-5,--effort,medium\u001b[m\u001b[1;12H\u001b[?25h"]
[24.683802, "o", "\u001b[?25l\r\u001b[32d\u001b[9S\u001b[H\u001b[38;5;215;48;5;235m❯ \u001b[1myoloctl\u001b[39;22m b\u001b[38;5;243mox\u001b[39m\u001b[17X\u001b[1;31H\u001b[38;5;243mEsc hide palette · ^←/→ tabs · ^R history · ^N notices · ^Q panes · ^D quit · \u001b[38;5;67;1myolo-team ▾\u001b[m\r\n\u001b[38;5;215;48;5;235;1m▸ box\u001b[39;22m  \u001b[38;5;243mManage boxes for coding agents, shells and other workloads\u001b[m\u001b[1;12H\u001b[?25h"]
[24.800458, "o", "\u001b[?25l\u001b[48;5;235mo\u001b[38;5;243mx\u001b[m\b\u001b[?25h"]
