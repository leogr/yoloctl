[47.467433, "o", "\u001b[4;2H\u001b[38;5;243;48;5;235m╭─\u001b[38;5;215;1m panes \u001b[38;5;243;22m───────────────────────────╮\u001b[m\n\u001b[2G\u001b[38;5;243;48;5;235m│\u001b[39m Split right\u001b[21X\u001b[5;36H| \u001b[38;5;243m│\u001b[m\n\u001b[2G\u001b[38;5;243;48;5;235m│\u001b[39m Split below\u001b[21X\u001b[6;36H- \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mZoom\u001b[28X\u001b[7;36Hz\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mSpread evenly\u001b[19X\u001b[8;36H=\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mSwap with previous\u001b[14X\u001b[9;36H{\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mSwap with next\u001b[18X\u001b[10;36H}\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m Break out\u001b[23X\u001b[11;36H! \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mBring a tab in\u001b[18X\u001b[12;36Hj\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m Detach pane\u001b[21X\u001b[13;36Hx \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243m─────────────────────────────────\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mFocus\u001b[24X\u001b[15;33H←↑↓→\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m Focus next\u001b[22X\u001b[16;36Ho \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243mResize border  ^arrows Alt+arrows\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m \u001b[38;5;243m─────────────────────────────────\u001b[39m \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m New tab\u001b[25X\u001b[19;36Hc \u001b[38;5;243m│\u001b[m\r\n \u001b[38;5;243;48;5;235m│\u001b[39m Switch space\u001b[20X\u001b[20;36Hs \u001b[