[27.867239, "o", "\b\b\b\u001b[38;5;215;48;5;235;1m .:.\u001b[m\r\n\u001b[48;5;235m    yoloctl.account=leogr\u001b[K\u001b[m\n\u001b[5G\u001b[48;5;235myoloctl.agent=codex\u001b[m\r\n\u001b[48;5;235m    yoloctl.agentbox=reviewer\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.audit.account=leogr\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.audit.network_unconfined=false\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.audit.runtime_mode=confined\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.audit.schema=1\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.base=yoloctl/agentbox:ubuntu-24.04\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.builder_version=4\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.kind=agentbox\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.openshell.control_root=/mnt/lima-ykhohume3pi/runtime/openshell/containers/785e58fa27f3ddf3d73b00b9401eb37a\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.openshell.helper_sha256=b4a2bcddf9f990897fe9bf4e7b54ba0a5276554fcf062fc16d06f7554425b9fc\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.openshell.incarnation=785e58fa27f3ddf3d73b00b9401eb37a\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.openshell.protocol=2\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.openshell.qualification=7d5a99149fca000f07bdefa9b0718b0fa83817da90e0b8df4e0aed224ef54e00\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.runtime_image=yoloctl/agentbox-composed:dcacf44e052f\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.space=yolo-team\u001b[K\u001b[m\r\n\u001b[48;5;235m    yoloctl.workload_pool=1\u001b[K\u001b[m\r\n\u001b[48;5;235m\u001b[K\u001b[m\n\u001b[48;5;235mDrift\u001b[K\u001b[m\r\n\u001b[48;5;235m  State:    in_sync\u001b[K\u001b[m\r\n\u001b[48;5;235m  Strategy: none (in sync)\u001b[K\u001b[m\r\n\u001b[48;5;235m  - container_running\u001b[K\u001b[m\r\n\u001b[38;5;243;48;5;235;4m (no tabs)\u001b[38;5;67m                                                                                                              \u001b[m\r\n\n\u001b[38;5;243m  Type a yoloctl command and press Enter, for example:\u001b[m\r\n\u001b[38;5;243m    box create coder --agent claude\u001b[m\r\n\u001b[38;5;243m    box attach coder\u001b[m\r\n\u001b[38;5;243m    space ls\u001b[m"]
