[27.467744, "o", "\u001b[?25l\u001b[0 q\u001b[3G\u001b[38;5;215;48;5;235;1m.:.    \u001b[39;22m\u001b[50X\u001b[1;60H\u001b[38;5;243mrunning · ^C interrupt · ^Y detach · ^←/→ tabs\u001b[m\r\n\u001b[38;5;215;48;5;235m❯ \u001b[39myoloctl box inspect reviewer\u001b[m\u001b[6;4H\u001b[38;5;243mype a yoloctl command and press Enter, for example:\u001b[m\u001b[K\u001b[7;16H\u001b[38;5;243mcoder --agent claude\u001b[m\u001b[K\n\u001b[3G\u001b[38;5;243m  box attach coder\u001b[m\u001b[K\r\n\u001b[38;5;243m    space ls\u001b[m"]
