# yoloctl Lima VM template
#
# Rendered at runtime via text/template. The sandbox policy Rego is
# substituted from a sibling file in this directory.

# Official release images, verified against Canonical's release-20261001
# SHA256SUMS. No moving fallback: comparisons must use the same image bytes.
images:
- location: https://cloud-images.ubuntu.com/minimal/releases/noble/release-20261001/ubuntu-24.04-minimal-cloudimg-amd64.img
  arch: x86_64
  digest: sha256:a8eb6570f87a941f3de2e000c046b9367f8ab1423756a94830d454fae8ad80ff
- location: https://cloud-images.ubuntu.com/minimal/releases/noble/release-20261001/ubuntu-24.04-minimal-cloudimg-arm64.img
  arch: aarch64
  digest: sha256:fbf6b15c50c474dc6dee5b3c74da212bb687a2625e877227828e6492d88dc151

cpus: {{.CPUs}}
memory: {{printf "%q" .Memory}}
disk: {{printf "%q" .Disk}}

# Let Lima select vmType, arch and mountType for the host.
mounts:
{{ .WritableMounts }}

{{ if .AccountDisk }}additionalDisks:
- name: "{{.AccountDisk}}"
  format: {{.FormatAccountDisk}}
  fsType: ext4
{{ end }}
containerd:
  system: true
  user: false
  # Select by guest architecture, including an amd64 CLI under Rosetta.
  # Keep the full stack aligned with Firecracker; no moving fallback.
  archives:
  - location: https://github.com/containerd/nerdctl/releases/download/v2.4.2/nerdctl-full-2.4.2-linux-amd64.tar.gz
    arch: x86_64
    digest: sha256:1f12c1a5840744fdf7029483c55a69813d44aa2ec1ef879d52d81ff6a3049ecd
  - location: https://github.com/containerd/nerdctl/releases/download/v2.4.2/nerdctl-full-2.4.2-linux-arm64.tar.gz
    arch: aarch64
    digest: sha256:fe0ef0e9840ee8932640e6058f84b7fa98050f9726e44af44883a5b804ae830e

provision:

# 1. Local hostname, sandbox user, /tmp permissions and yoloctl directories.
- mode: system
  script: |
    #!/bin/bash
    set -eux -o pipefail
    # Resolve the guest's own name locally before a sudo command needs it.
    add_local_hostname() {
      local name=$1 hosts=$2 mapped last_byte
      mapped=$(LC_ALL=C awk -v name="$name" '
        BEGIN { name = tolower(name) }
        {
          sub(/#.*/, "")
          for (i = 2; i <= NF; i++) {
            if (tolower($i) == name) { found = 1; exit }
          }
        }
        END { print found ? "yes" : "no" }
      ' "$hosts")
      if [ "$mapped" = yes ]; then
        return
      fi
      last_byte=$(tail -c 1 "$hosts")
      {
        if [ -n "$last_byte" ]; then
          printf '\n'
        fi
        printf '127.0.1.1 %s\n' "$name"
      } >> "$hosts"
    }
    vm_hostname=$(hostname)
    add_local_hostname "$vm_hostname" /etc/hosts
    chmod 1777 /tmp
    if ! getent group sandbox >/dev/null; then
      groupadd -g 2000 sandbox
    fi
    if ! id -u sandbox >/dev/null 2>&1; then
      useradd -u 2000 -g sandbox -d /home/sandbox -s /bin/bash -m sandbox
    fi
    mkdir -p /etc/yoloctl

# 2. VM runtime dependencies. Native OpenShell executables, helper and Rego
#    are installed from the qualified controller artifacts at box creation.
- mode: system
  script: |
    #!/bin/bash
    set -eux -o pipefail
    # Lima runs system provisioning again on restart. Query dpkg on each boot
    # so a missing or incompletely installed package is repaired, without
    # repeating apt/network work when all runtime dependencies are installed.
    # The pinned image ships an older CA package. An apt upgrade lets its
    # package scripts regenerate /etc/ssl/certs, keeping local CAs and
    # deselections; this release distrusts emSign ECC Root CA - G3
    # (LP: #2171507).
    ca_minimum=20260816ubuntu0.24.04.1
    ca_current() {
      dpkg-query -W -f='${Version}' ca-certificates 2>/dev/null || true
    }
    missing=()
    for package in ca-certificates curl socat python3; do
      if [ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != "install ok installed" ]; then
        missing+=("$package")
      elif [ "$package" = ca-certificates ] && ! dpkg --compare-versions "$(ca_current)" ge "$ca_minimum"; then
        missing+=("$package")
      fi
    done
    if [ "${#missing[@]}" -gt 0 ]; then
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y --no-install-recommends "${missing[@]}"
    else
      echo 'yoloctl: VM runtime packages already installed'
    fi
    ca_version=$(ca_current)
    if [ -z "$ca_version" ] || ! dpkg --compare-versions "$ca_version" ge "$ca_minimum"; then
      echo "yoloctl: ca-certificates ${ca_version:-missing} is older than $ca_minimum" >&2
      exit 1
    fi

# Native OpenShell egress needs the distro nft CLI and its matching libraries.
- mode: system
  script: |
    #!/bin/bash
    set -eux -o pipefail
    # yoloctl-openshell-vm: nftables-v2
    if [ "$(dpkg-query -W -f='${Status}' nftables 2>/dev/null || true)" != 'install ok installed' ] || [ ! -x /usr/sbin/nft ]; then
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y --no-install-recommends nftables
    fi
    test -x /usr/sbin/nft
    /usr/sbin/nft --version

# Lima installs the selected archive before system provisioning. Omit the
# older TLS verifier in buildg only for the qualified archive.
- mode: system
  script: |
    #!/bin/bash
    set -eu -o pipefail
    status=/run/yoloctl-container-stack
    rm -f -- "$status"
    bin=$(realpath -ms -- "${LIMA_CIDATA_GUEST_INSTALL_PREFIX:-/usr/local}/bin")
    debugger="$bin/buildg"
    if [[ ! -e "$debugger" && ! -L "$debugger" ]]; then
      printf '%s\n' "$debugger" > "$status"
      exit 0
    fi
    archive_checksum=
    case $(uname -m) in
      x86_64)
        archive_checksum=1f12c1a5840744fdf7029483c55a69813d44aa2ec1ef879d52d81ff6a3049ecd
        debugger_checksum=81d5e8ba34d5c923196d69834dbf142affbb6b2ce5ec2ff1d4c96dc65672cc18
        ;;
      aarch64)
        archive_checksum=fe0ef0e9840ee8932640e6058f84b7fa98050f9726e44af44883a5b804ae830e
        debugger_checksum=0bd5ed100fda179043afaa79e77a41931a9c9b95b9333e8ea5fd8844e5e165d0
        ;;
    esac
    archive=
    # The cidata member name is the same for the default and an override.
    if [[ -n "${LIMA_CIDATA_MNT:-}" && -n "${LIMA_CIDATA_CONTAINERD_ARCHIVE:-}" ]]; then
      archive="$LIMA_CIDATA_MNT/$LIMA_CIDATA_CONTAINERD_ARCHIVE"
    fi
    if [[ ! -f "$archive" ]] || ! digest=$(sha256sum < "$archive"); then
      echo 'yoloctl: cannot identify the selected Lima container archive' >&2
      exit 1
    fi
    if [[ "$digest" != "$archive_checksum  -" ]]; then
      echo 'yoloctl: Lima container stack is outside the qualified archive pins' >&2
      printf 'unqualified\n' > "$status"
      exit 0
    fi
    if [[ $(realpath -e -- "$bin") != "$bin" || -L "$debugger" || ! -f "$debugger" ]]; then
      echo 'yoloctl: refusing to remove buildg from an unexpected path' >&2
      exit 1
    fi
    dir=$bin
    while [[ "$dir" != / ]]; do
      read -r owner mode < <(stat -c '%u %a' -- "$dir")
      if [[ "$owner" != 0 ]] || (( 8#$mode & 022 )); then
        echo "yoloctl: refusing to remove buildg from writable or non-root directory $dir" >&2
        exit 1
      fi
      dir=$(dirname -- "$dir")
    done
    if [[ $(stat -c '%u' -- "$debugger") != 0 || $(sha256sum < "$debugger") != "$debugger_checksum  -" ]]; then
      echo 'yoloctl: refusing to remove a buildg executable outside the pinned archive' >&2
      exit 1
    fi
    rm -- "$debugger"
    printf '%s\n' "$debugger" > "$status"

probes:
- mode: readiness
  description: "native OpenShell nftables is installed"
  script: |
    #!/bin/bash
    set -eux -o pipefail
    test -x /usr/sbin/nft
    /usr/sbin/nft --version
  hint: |
    nftables provisioning failed. Check the Lima cloud-init provision log.

- mode: readiness
  description: "containerd is running and container archive provisioning passed"
  script: |
    #!/bin/bash
    set -eux -o pipefail
    if ! timeout 30s bash -c "until sudo nerdctl info > /dev/null 2>&1; do sleep 1; done"; then
      echo >&2 "containerd is not running"
      exit 1
    fi
    result=$(sudo cat /run/yoloctl-container-stack)
    case "$result" in
      unqualified) ;;
      /*/buildg) test ! -e "$result" && test ! -L "$result" ;;
      *) exit 1 ;;
    esac
  hint: |
    Check the Lima cloud-init provision log and systemctl status containerd.

# Auto-forward all guest localhost ports to host.
portForwards:
- guestIP: "127.0.0.1"
  guestPortRange: [1, 65535]
  hostIP: "127.0.0.1"
